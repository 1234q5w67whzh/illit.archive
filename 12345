/* =========================================================
   PREVIEW DE FOTO DO MEMBRO
   ========================================================= */

function previewMemberPhoto(member, event) {

  const file =
    event.target.files[0];

  if (!file) return;

  const reader =
    new FileReader();

  reader.onload =
    function(e) {

      const image =
        e.target.result;

      /*
        Guardamos temporariamente a imagem
        no objeto do membro.
      */

      memberProfiles[member].image =
        image;

      const preview =
        document.getElementById(
          `profile-photo-preview-${member}`
        );

      if (preview) {

        preview.innerHTML = `

          <img
            src="${image}"
            alt="${member}"
          >

        `;

      }

      const livePreview =
        document.getElementById(
          `live-preview-image-${member}`
        );

      if (livePreview) {

        livePreview.innerHTML = `

          <img
            src="${image}"
            alt="${member}"
          >

        `;

      }

    };

  reader.readAsDataURL(file);

}

/* =========================================================
   PREVIEW EM TEMPO REAL
   ========================================================= */

function updateLiveProfile(member) {

  const data =
    memberProfiles[member];

  const nameInput =
    document.getElementById(
      `profile-name-${member}`
    );

  const bioInput =
    document.getElementById(
      `profile-bio-${member}`
    );

  const previewName =
    document.getElementById(
      `live-preview-name-${member}`
    );

  const previewBio =
    document.getElementById(
      `live-preview-bio-${member}`
    );

  if (nameInput && previewName) {

    previewName.textContent =
      nameInput.value || data.name;

  }

  if (bioInput && previewBio) {

    previewBio.textContent =
      bioInput.value || "Biografia do membro";

  }

}

/* =========================================================
   SALVAR PERFIL — VERSÃO FINAL
   ========================================================= */

function saveMemberProfile(name) {

  if (!memberProfiles[name]) return;

  const nameInput =
    document.getElementById(
      `profile-name-${name}`
    );

  const birthInput =
    document.getElementById(
      `profile-birth-${name}`
    );

  const positionInput =
    document.getElementById(
      `profile-position-${name}`
    );

  const nationalityInput =
    document.getElementById(
      `profile-nationality-${name}`
    );

  const bioInput =
    document.getElementById(
      `profile-bio-${name}`
    );

  memberProfiles[name].name =
    nameInput
      ? nameInput.value.trim()
      : memberProfiles[name].name;

  memberProfiles[name].birth =
    birthInput
      ? birthInput.value.trim()
      : "";

  memberProfiles[name].position =
    positionInput
      ? positionInput.value.trim()
      : "";

  memberProfiles[name].nationality =
    nationalityInput
      ? nationalityInput.value.trim()
      : "";

  memberProfiles[name].bio =
    bioInput
      ? bioInput.value.trim()
      : "";

  saveArchiveEverything();

  refreshProfileInformation();

  alert(
    `${memberProfiles[name].name} foi atualizado!`
  );

}

