/* ==========================================
   LOGIN
   ========================================== */

function loginAdmin() {

  const password =
    document.getElementById("adminPassword").value;

  const message =
    document.getElementById("loginMessage");

  if (password === ADMIN_PASSWORD) {

    adminLoggedIn = true;

    document.getElementById("adminLogin").style.display = "none";

    document.getElementById("adminPanel").style.display = "flex";

    message.textContent = "";

    loadAdminData();

    renderAdminActivities();

    renderMemberEditors();

  } else {

    message.textContent = "Senha incorreta.";

    message.style.color = "#ff3b30";

  }

}

/* ==========================================
   LOGOUT
   ========================================== */

function logoutAdmin() {

  adminLoggedIn = false;

  document.getElementById("adminPanel").style.display = "none";

  document.getElementById("adminLogin").style.display = "block";

  document.getElementById("adminPassword").value = "";

}

/* ==========================================
   TABS
   ========================================== */

function switchAdminTab(tab) {

  const activities =
    document.getElementById("adminActivities");

  const members =
    document.getElementById("adminMembers");

  const activityTab =
    document.getElementById("adminTabActivities");

  const memberTab =
    document.getElementById("adminTabMembers");

  if (tab === "activities") {

    activities.style.display = "flex";

    members.style.display = "none";

    activityTab.classList.add("active");

    memberTab.classList.remove("active");

  } else {

    activities.style.display = "none";

    members.style.display = "flex";

    activityTab.classList.remove("active");

    memberTab.classList.add("active");

  }

}

/* ==========================================
   ABRIR EDITOR
   ========================================== */

function openActivityEditor(activity = null) {

  const editor =
    document.getElementById("activityEditor");

  editor.style.display = "block";

  document.getElementById("activitySaveMessage").textContent = "";

  if (!activity) {

    document.getElementById("activityEditorTitle").textContent =
      "Nova atividade";

    document.getElementById("editingActivityId").value = "";

    document.getElementById("activityMember").value = "all";

    document.getElementById("activityType").value = "Show";

    document.getElementById("activityTitle").value = "";

    document.getElementById("activityDescription").value = "";

    document.getElementById("activityStartDate").value = "";

    document.getElementById("activityEndDate").value = "";

    document.getElementById("activityStartTime").value = "";

    document.getElementById("activityEndTime").value = "";

    document.getElementById("activityLocation").value = "";

    document.getElementById("activityCity").value = "";

    document.getElementById("activityCountry").value = "";

    document.getElementById("activityStatus").value = "Confirmed";

    document.getElementById("activityOfficialLink").value = "";

    document.getElementById("activityStreamLink").value = "";

    document.getElementById("activityNotes").value = "";

    document.getElementById("activityImagePreview").innerHTML =
      "<span>🖼️</span><small>Escolher imagem</small>";

  } else {

    document.getElementById("activityEditorTitle").textContent =
      "Editar atividade";

    document.getElementById("editingActivityId").value =
      activity.id;

    document.getElementById("activityMember").value =
      activity.member || "all";

    document.getElementById("activityType").value =
      activity.type || "Other";

    document.getElementById("activityTitle").value =
      activity.title || "";

    document.getElementById("activityDescription").value =
      activity.description || "";

    document.getElementById("activityStartDate").value =
      activity.startDate || "";

    document.getElementById("activityEndDate").value =
      activity.endDate || activity.startDate || "";

    document.getElementById("activityStartTime").value =
      activity.startTime || "";

    document.getElementById("activityEndTime").value =
      activity.endTime || "";

    document.getElementById("activityLocation").value =
      activity.location || "";

    document.getElementById("activityCity").value =
      activity.city || "";

    document.getElementById("activityCountry").value =
      activity.country || "";

    document.getElementById("activityStatus").value =
      activity.status || "Confirmed";

    document.getElementById("activityOfficialLink").value =
      activity.officialLink || "";

    document.getElementById("activityStreamLink").value =
      activity.streamLink || "";

    document.getElementById("activityNotes").value =
      activity.notes || "";

    if (activity.image) {

      document.getElementById("activityImagePreview").innerHTML =
        `<img src="${activity.image}" alt="Preview">`;

    } else {

      document.getElementById("activityImagePreview").innerHTML =
        "<span>🖼️</span><small>Escolher imagem</small>";

    }

  }

  editor.scrollIntoView({
    behavior: "smooth",
    block: "start"
  });

}

/* ==========================================
   FECHAR EDITOR
   ========================================== */

function closeActivityEditor() {

  document.getElementById("activityEditor").style.display = "none";

}

/* ==========================================
   PREVIEW DA IMAGEM
   ========================================== */

function previewActivityImage(event) {

  const file = event.target.files[0];

  if (!file) return;

  const reader = new FileReader();

  reader.onload = function(e) {

    document.getElementById("activityImagePreview").innerHTML =
      `<img src="${e.target.result}" alt="Preview">`;

  };

  reader.readAsDataURL(file);

}

/* ==========================================
   SALVAR ATIVIDADE
   ========================================== */

function saveActivity() {

  const id =
    document.getElementById("editingActivityId").value ||
    "activity-" + Date.now();

  const existing =
    adminActivities.find(item => item.id === id);

  const activity = {

    id: id,

    member:
      document.getElementById("activityMember").value,

    type:
      document.getElementById("activityType").value,

    title:
      document.getElementById("activityTitle").value.trim(),

    description:
      document.getElementById("activityDescription").value.trim(),

    startDate:
      document.getElementById("activityStartDate").value,

    endDate:
      document.getElementById("activityEndDate").value,

    startTime:
      document.getElementById("activityStartTime").value,

    endTime:
      document.getElementById("activityEndTime").value,

    location:
      document.getElementById("activityLocation").value.trim(),

    city:
      document.getElementById("activityCity").value.trim(),

    country:
      document.getElementById("activityCountry").value.trim(),

    status:
      document.getElementById("activityStatus").value,

    officialLink:
      document.getElementById("activityOfficialLink").value.trim(),

    streamLink:
      document.getElementById("activityStreamLink").value.trim(),

    notes:
      document.getElementById("activityNotes").value.trim(),

    image:
      existing?.image || ""

  };

  if (!activity.title || !activity.startDate) {

    const message =
      document.getElementById("activitySaveMessage");

    message.textContent =
      "Preencha pelo menos o título e a data.";

    message.style.color = "#ff3b30";

    return;

  }

  const imageFile =
    document.getElementById("activityImage").files[0];

  if (imageFile) {

    const reader = new FileReader();

    reader.onload = function(e) {

      activity.image = e.target.result;

      finishSavingActivity(activity);

    };

    reader.readAsDataURL(imageFile);

  } else {

    finishSavingActivity(activity);

  }

}

/* ==========================================
   FINALIZAR SALVAMENTO
   ========================================== */

function finishSavingActivity(activity) {

  const index =
    adminActivities.findIndex(item => item.id === activity.id);

  if (index >= 0) {

    adminActivities[index] = activity;

  } else {

    adminActivities.push(activity);

  }

  saveAdminData();

  renderAdminActivities();

  renderCalendarFromAdmin();

  renderStatisticsFromAdmin();

  document.getElementById("activitySaveMessage").textContent =
    "✓ Atividade salva.";

  document.getElementById("activitySaveMessage").style.color =
    "#34c759";

  setTimeout(() => {

    closeActivityEditor();

  }, 700);

}

/* ==========================================
   LISTA ADMIN
   ========================================== */

function renderAdminActivities() {

  const container =
    document.getElementById("adminActivityList");

  if (!container) return;

  const count =
    adminActivities.length;

  document.getElementById("adminActivityCount").textContent =
    count === 1
      ? "1 atividade cadastrada"
      : `${count} atividades cadastradas`;

  if (!count) {

    container.innerHTML = `
      <div class="glass-card" style="padding:30px;text-align:center;">
        <div style="font-size:35px;margin-bottom:10px;">📅</div>
        <strong>Nenhuma atividade</strong>
        <p style="opacity:.55;margin-bottom:0;">
          Clique em “Nova atividade” para começar.
        </p>
      </div>
    `;

    return;

  }

  const sorted =
    [...adminActivities].sort((a,b) =>
      a.startDate.localeCompare(b.startDate)
    );

  container.innerHTML =
    sorted.map(activity => {

      const member =
        getMemberData(activity.member);

      return `

        <div class="admin-activity glass-card">

          <div class="admin-activity-icon">
            ${member.emoji}
          </div>

          <div class="admin-activity-info">

            <strong>
              ${escapeAdminText(activity.title)}
            </strong>

            <span>
              ${activity.startDate}
              ·
              ${escapeAdminText(activity.type)}
              ·
              ${member.name}
            </span>

          </div>

          <div class="admin-activity-actions">

            <button
              class="small-action"
              onclick="editActivity('${activity.id}')"
              title="Editar"
            >
              ✏️
            </button>

            <button
              class="small-action delete"
              onclick="deleteActivity('${activity.id}')"
              title="Excluir"
            >
              🗑️
            </button>

          </div>

        </div>

      `;

    }).join("");

}

/* ==========================================
   EDITAR
   ========================================== */

function editActivity(id) {

  const activity =
    adminActivities.find(item => item.id === id);

  if (!activity) return;

  openActivityEditor(activity);

}

/* ==========================================
   EXCLUIR
   ========================================== */

function deleteActivity(id) {

  const activity =
    adminActivities.find(item => item.id === id);

  if (!activity) return;

  const confirmed =
    confirm(
      `Excluir "${activity.title}"?`
    );

  if (!confirmed) return;

  adminActivities =
    adminActivities.filter(item => item.id !== id);

  saveAdminData();

  renderAdminActivities();

  renderCalendarFromAdmin();

  renderStatisticsFromAdmin();

}

/* ==========================================
   PERFIS
   ========================================== */

function renderMemberEditors() {

  const container =
    document.getElementById("memberEditorList");

  if (!container) return;

  container.innerHTML =
    Object.values(memberProfiles).map(member => `

      <div class="member-editor-card glass-card">

        <div class="member-editor-top">

          <div
            class="member-editor-avatar"
            style="box-shadow:inset 0 0 0 2px ${member.color}33;"
          >
            ${member.emoji}
          </div>

          <div>
            <strong>${member.name}</strong>
            <span>Editar informações do perfil</span>
          </div>

