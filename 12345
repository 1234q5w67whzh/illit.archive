        },

        {
          id: 5,
          member: "WONHEE",
          icon: "🐿️",
          color: "#ffb6d9",
          title: "WONHEE — atividade de exemplo",
          type: "TV",
          date: "2026-09-23",
          time: "20:00",
          location: "Seoul",
          status: "Confirmed"
        },

        {
          id: 6,
          member: "IROHA",
          icon: "🐢",
          color: "#8ed8ff",
          title: "IROHA — atividade de exemplo",
          type: "Content",
          date: "2026-09-27",
          time: "18:30",
          location: "Online",
          status: "Confirmed"
        }

      ];

      /* =================================================
         CALENDAR STATE
         ================================================= */

      let calendarDate =
        new Date(2026, 8, 1);

      let selectedCalendarFilter = "all";

      let selectedCalendarDay = null;

      /* =================================================
         MEMBER INFORMATION
         ================================================= */

      const calendarMembers = {

        all: {
          icon: "✨",
          name: "Todas as atividades",
          color: "#8c8c92"
        },

        YUNAH: {
          icon: "🐆",
          name: "YUNAH",
          color: "#ff3b30"
        },

        MINJU: {
          icon: "🐰",
          name: "MINJU",
          color: "#ffcc00"
        },

        MOKA: {
          icon: "☕️",
          name: "MOKA",
          color: "#af8cff"
        },

        WONHEE: {
          icon: "🐿️",
          name: "WONHEE",
          color: "#ffb6d9"
        },

        IROHA: {
          icon: "🐢",
          name: "IROHA",
          color: "#8ed8ff"
        }

      };

      /* =================================================
         MONTH NAMES
         ================================================= */

      const calendarMonthNames = [

        "Janeiro",
        "Fevereiro",
        "Março",
        "Abril",
        "Maio",
        "Junho",
        "Julho",
        "Agosto",
        "Setembro",
        "Outubro",
        "Novembro",
        "Dezembro"

      ];

      /* =================================================
         FILTER
         ================================================= */

      function selectCalendarTab(button, filter) {

        document
          .querySelectorAll(".calendar-tab")
          .forEach(tab => {

            tab.classList.remove("active");

          });

        button.classList.add("active");

        selectedCalendarFilter = filter;

        selectedCalendarDay = null;

        const member =
          calendarMembers[filter];

        document
          .getElementById("calendarFilterLabel")
          .textContent =
            member.icon +
            " " +
            member.name;

        renderCalendar();

        renderUpcoming();

      }

      /* =================================================
         FILTERED ACTIVITIES
         ================================================= */

      function getFilteredActivities() {

        if (
          selectedCalendarFilter === "all"
        ) {

          return calendarActivities;

        }

        return calendarActivities.filter(
          activity =>
            activity.member ===
            selectedCalendarFilter
        );

      }

      /* =================================================
         RENDER CALENDAR
         ================================================= */

      function renderCalendar() {

        const year =
          calendarDate.getFullYear();

        const month =
          calendarDate.getMonth();

        document
          .getElementById("calendarMonthName")
          .textContent =
            calendarMonthNames[month] +
            " " +
            year;

        const container =
          document.getElementById(
            "calendarDays"
          );

        container.innerHTML = "";

        const firstDay =
          new Date(
            year,
            month,
            1
          ).getDay();

        const daysInMonth =
          new Date(
            year,
            month + 1,
            0
          ).getDate();

        const filtered =
          getFilteredActivities();

        for (
          let i = 0;
          i < firstDay;
          i++
        ) {

          const empty =
            document.createElement("div");

          empty.className =
            "calendar-day empty";

          container.appendChild(empty);

        }

        for (
          let day = 1;
          day <= daysInMonth;
          day++
        ) {

          const dayElement =
            document.createElement("div");

          dayElement.className =
            "calendar-day";

          const dateString =
            formatCalendarDate(
              year,
              month + 1,
              day
            );

          const dayActivities =
            filtered.filter(
              activity =>
                activity.date ===
                dateString
            );

          const number =
            document.createElement("div");

          number.className =
            "calendar-day-number";

          number.textContent = day;

          /* TODAY */

          const now =
            new Date();

          if (
            now.getFullYear() === year &&
            now.getMonth() === month &&
            now.getDate() === day
          ) {

            dayElement.classList.add(
              "today"
            );

          }

          /* SELECTED */

          if (
            selectedCalendarDay ===
            dateString
          ) {

            dayElement.classList.add(
              "selected"
            );

          }

          dayElement.appendChild(number);

          /* EVENTS */

          if (
            dayActivities.length > 0
          ) {

            const events =
              document.createElement("div");

            events.className =
              "calendar-events";

            dayActivities
              .slice(0, 3)
              .forEach(activity => {

                const dot =
                  document.createElement("div");

                dot.className =
                  "calendar-event-dot";

                dot.style
                  .setProperty(
                    "--event-color",
                    activity.color
                  );

                events.appendChild(dot);

              });

            if (
              dayActivities.length > 3
            ) {

              const more =
                document.createElement("div");

              more.className =
                "calendar-more";

              more.textContent =
                "+" +
                (dayActivities.length - 3);

              events.appendChild(more);

            }

            dayElement.appendChild(events);

          }

          dayElement.onclick =
            function() {

              selectCalendarDay(
                dateString
              );

            };

          container.appendChild(
            dayElement
          );

        }

      }

      /* =================================================
         FORMAT DATE
         ================================================= */

      function formatCalendarDate(
        year,
        month,
        day
      ) {

        return (
          year +
          "-" +
          String(month).padStart(2, "0") +
          "-" +
          String(day).padStart(2, "0")
        );

      }

      /* =================================================
         SELECT DAY
         ================================================= */

      function selectCalendarDay(
        dateString
      ) {

        selectedCalendarDay =
          dateString;

        const activities =
          getFilteredActivities()
            .filter(
              activity =>
                activity.date ===
                dateString
            );

        const date =
          new Date(
            dateString + "T12:00:00"
          );

        const formatted =
          date.toLocaleDateString(
            "pt-BR",
            {
              weekday: "long",
              day: "numeric",
              month: "long"
            }
          );

        document
          .getElementById(
            "selectedDayTitle"
          )
          .textContent =
            formatted;

        renderSelectedActivities(
          activities
        );

        renderCalendar();

      }

      /* =================================================
         SELECTED ACTIVITIES
         ================================================= */

      function renderSelectedActivities(
        activities
      ) {

        const container =
          document.getElementById(
            "activityList"
          );

        container.innerHTML = "";

        if (
          activities.length === 0
        ) {

          container.innerHTML = `

            <div class="empty-activity">

              <div>
                💤
              </div>

              <p>
                Nenhuma atividade neste dia.
              </p>

            </div>

          `;

          return;

        }

        activities.forEach(
          activity => {

            const item =
              document.createElement("div");

            item.className =
              "activity-item";

            item.style
              .setProperty(
                "--activity-color",
                activity.color
              );

            item.innerHTML = `

              <div
                class="activity-member-icon"
              >
                ${activity.icon}
              </div>

              <div
                class="activity-content"
              >

                <div
                  class="activity-title"
                >
                  ${activity.title}
                </div>

                <div
                  class="activity-meta"
                >

                  <span>
                    ${activity.type}
                  </span>

                  <span>•</span>

                  <span>
                    ${activity.time}
                  </span>

                  ${
                    activity.location
                      ? `
                        <span>•</span>
                        <span>
                          ${activity.location}
                        </span>
                      `
                      : ""
                  }

                </div>

              </div>

              <div
                class="activity-status"
              >
                ${activity.status}
              </div>

            `;

            container.appendChild(item);

          }
        );

      }

      /* =================================================
         UPCOMING
         ================================================= */

      function renderUpcoming() {

        const container =
          document.getElementById(
            "upcomingList"
          );

        container.innerHTML = "";

        const today =
          new Date();

        today.setHours(
          0, 0, 0, 0
        );

        const upcoming =
          getFilteredActivities()
            .filter(activity => {

              const date =
                new Date(
                  activity.date +
                  "T12:00:00"
                );

              return date >= today;

            })
            .sort(
              (a, b) =>
                a.date.localeCompare(
                  b.date
                )
            )
            .slice(0, 6);

        document
          .getElementById(
            "upcomingCount"
          )
          .textContent =
            upcoming.length;

        if (
          upcoming.length === 0
        ) {

          container.innerHTML = `

            <div
              class="empty-activity"
              style="grid-column:1/-1;"
            >

              <div>
                ✨
              </div>

              <p>
                Nenhuma atividade futura encontrada.
              </p>

            </div>

          `;

          return;

        }

        upcoming.forEach(
          activity => {

            const date =
              new Date(
                activity.date +
                "T12:00:00"
              );

            const item =
              document.createElement("div");

            item.className =
              "upcoming-item";

            item.style
              .setProperty(
                "--activity-color",
                activity.color
              );

            item.innerHTML = `

              <div
                class="upcoming-date"
              >

                <span
                  class="upcoming-date-day"
                >
                  ${date.getDate()}
                </span>

                <span
                  class="upcoming-date-month"
                >
                  ${
                    calendarMonthNames[
                      date.getMonth()
                    ].slice(0, 3)
                  }
                </span>

              </div>

              <div
                class="upcoming-info"
              >

                <h4>
                  ${activity.title}
                </h4>

                <p>
                  ${activity.icon}
                  ${activity.member === "all"
                    ? "ILLIT"
                    : activity.member}
                  ·
                  ${activity.time}
                </p>

              </div>

            `;

            container.appendChild(item);

          }
        );

      }

      /* =================================================
         CHANGE MONTH
         ================================================= */

      function changeCalendarMonth(
        direction
      ) {

        calendarDate.setMonth(
          calendarDate.getMonth() +
          direction
        );

        selectedCalendarDay = null;

        renderCalendar();

        renderUpcoming();

      }

      /* =================================================
         START CALENDAR
         ================================================= */

      document.addEventListener(
        "DOMContentLoaded",
        function() {

          renderCalendar();

          renderUpcoming();

        }
      );

    </script>

