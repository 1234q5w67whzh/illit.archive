<script>
/* =========================================================
   SISTEMA DE TEMA
   ========================================================= */

/* ---------- CHAVE ---------- */

const THEME_STORAGE_KEY =
    "illitArchiveTheme";

/* ---------- DEFINIR TEMA ---------- */

function setArchiveTheme(theme){

    const html =
        document.documentElement;

    if(theme === "dark"){

        html.classList.add("dark-mode");

    }else{

        html.classList.remove("dark-mode");

    }

    localStorage.setItem(
        THEME_STORAGE_KEY,
        theme
    );

    updateThemeButton();

}

/* ---------- TEMA SALVO ---------- */

function getSavedArchiveTheme(){

    const saved =
        localStorage.getItem(
            THEME_STORAGE_KEY
        );

    if(
        saved === "dark" ||
        saved === "light"
    ){
        return saved;
    }

    /*
       Se nunca escolheu, acompanha
       a preferência do sistema.
    */

    if(
        window.matchMedia &&
        window.matchMedia(
            "(prefers-color-scheme: dark)"
        ).matches
    ){
        return "dark";
    }

    return "light";

}

/* ---------- INICIALIZAÇÃO ANTES DA PÁGINA ---------- */

(function(){

    const theme =
        getSavedArchiveTheme();

    if(theme === "dark"){

        document.documentElement
            .classList
            .add("dark-mode");

    }

})();

/* =========================================================
   BOTÃO
   ========================================================= */

function updateThemeButton(){

    const button =
        document.getElementById(
            "archiveThemeToggle"
        );

    if(!button) return;

    const icon =
        button.querySelector(
            ".theme-icon"
        );

    const dark =
        document.documentElement
            .classList
            .contains("dark-mode");

    if(icon){

        icon.textContent =
            dark ? "☀️" : "🌙";

    }

    button.setAttribute(
        "aria-label",
        dark
            ? "Ativar modo claro"
            : "Ativar modo escuro"
    );

    button.setAttribute(
        "title",
        dark
            ? "Modo claro"
            : "Modo escuro"
    );

}

/* =========================================================
   ALTERNAR
   ========================================================= */

function toggleArchiveTheme(){

    const dark =
        document.documentElement
            .classList
            .contains("dark-mode");

    setArchiveTheme(
        dark ? "light" : "dark"
    );

    showArchiveToast(
        dark
            ? "☀️ Modo claro ativado"
            : "🌙 Modo escuro ativado"
    );

}

/* =========================================================
   INSERIR BOTÃO NO HEADER
   ========================================================= */

function injectThemeButton(){

    if(
        document.getElementById(
            "archiveThemeToggle"
        )
    ){
        updateThemeButton();
        return;
    }

    const button =
        document.createElement("button");

    button.id =
        "archiveThemeToggle";

    button.className =
        "theme-toggle";

    button.type =
        "button";

    button.innerHTML = `
        <span class="theme-icon">
            🌙
        </span>
    `;

    button.onclick =
        toggleArchiveTheme;

    /*
       Procuramos primeiro o header.
    */

    const header =
        document.querySelector("header");

    if(header){

        /*
           Tenta colocar no final do header.
        */

        header.appendChild(button);

    }else{

        document.body.appendChild(button);

        button.style.position =
            "fixed";

        button.style.top =
            "16px";

        button.style.right =
            "16px";

        button.style.zIndex =
            "9999";

    }

    updateThemeButton();

}

/* =========================================================
   TOAST
   ========================================================= */

let archiveToastTimer = null;

function showArchiveToast(message){

    let toast =
        document.getElementById(
            "archiveToast"
        );

    if(!toast){

        toast =
            document.createElement("div");

        toast.id =
            "archiveToast";

        toast.className =
            "archive-toast";

        document.body.appendChild(toast);

    }

    toast.textContent =
        message;

    clearTimeout(
        archiveToastTimer
    );

    requestAnimationFrame(() => {

        toast.classList.add("show");

    });

    archiveToastTimer =
        setTimeout(() => {

            toast.classList.remove(
                "show"
            );

        },2200);

}

/* =========================================================
   ATUALIZAR COM PREFERÊNCIA DO SISTEMA
   ========================================================= */

if(window.matchMedia){

    const media =
        window.matchMedia(
            "(prefers-color-scheme: dark)"
        );

    media.addEventListener?.(
        "change",
        event => {

            /*
               Só acompanha automaticamente
               se o usuário nunca escolheu
               manualmente.
            */

            if(
                !localStorage.getItem(
                    THEME_STORAGE_KEY
                )
            ){

                setArchiveTheme(
                    event.matches
                        ? "dark"
                        : "light"
                );

            }

        }
    );

}

/* =========================================================
   INICIALIZAÇÃO
   ========================================================= */

document.addEventListener(
    "DOMContentLoaded",
    () => {

        injectThemeButton();

    }
);

/* =========================================================
   EXPORTAR
   ========================================================= */

window.toggleArchiveTheme =
    toggleArchiveTheme;

window.setArchiveTheme =
    setArchiveTheme;

window.showArchiveToast =
    showArchiveToast;

</script>

