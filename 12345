<script>
/* =========================================================
   PARTE 14 — NAVEGAÇÃO
   ========================================================= */

/* =========================================================
   MENU MOBILE
   ========================================================= */

function injectArchiveMobileNavigation(){

    if(
        document.getElementById(
            "archiveMobileNav"
        )
    ){
        return;
    }

    const nav =
        document.createElement(
            "nav"
        );

    nav.id =
        "archiveMobileNav";

    nav.className =
        "archive-mobile-nav";

    nav.setAttribute(
        "aria-label",
        "Navegação principal"
    );

    nav.innerHTML = `

        <div class="archive-mobile-nav-inner">

            <button
                class="archive-mobile-nav-button active"
                data-target="home"
                type="button"
            >

                <span
                    class="archive-mobile-nav-icon"
                >
                    🏠
                </span>

                <span
                    class="archive-mobile-nav-label"
                >
                    Início
                </span>

            </button>

            <button
                class="archive-mobile-nav-button"
                data-target="profile"
                type="button"
            >

                <span
                    class="archive-mobile-nav-icon"
                >
                    ✨
                </span>

                <span
                    class="archive-mobile-nav-label"
                >
                    Perfil
                </span>

            </button>

            <button
                class="archive-mobile-nav-button"
                data-target="calendar"
                type="button"
            >

                <span
                    class="archive-mobile-nav-icon"
                >
                    📅
                </span>

                <span
                    class="archive-mobile-nav-label"
                >
                    Agenda
                </span>

            </button>

            <button
                class="archive-mobile-nav-button"
                data-target="status"
                type="button"
            >

                <span
                    class="archive-mobile-nav-icon"
                >
                    📊
                </span>

                <span
                    class="archive-mobile-nav-label"
                >
                    Stats
                </span>

            </button>

            <button
                class="archive-mobile-nav-button"
                data-target="admin"
                type="button"
            >

                <span
                    class="archive-mobile-nav-icon"
                >
                    ⚙️
                </span>

                <span
                    class="archive-mobile-nav-label"
                >
                    Admin
                </span>

            </button>

        </div>

    `;

    document.body.appendChild(
        nav
    );

    const buttons =
        nav.querySelectorAll(
            ".archive-mobile-nav-button"
        );

    buttons.forEach(
        button => {

            button.addEventListener(
                "click",
                () => {

                    const targetId =
                        button.dataset.target;

                    const target =
                        document.getElementById(
                            targetId
                        );

                    if(target){

                        target.scrollIntoView({
                            behavior:"smooth",
                            block:"start"
                        });

                    }

                }
            );

        }
    );

}

/* =========================================================
   VOLTAR AO TOPO
   ========================================================= */

function injectArchiveBackTop(){

    if(
        document.getElementById(
            "archiveBackTop"
        )
    ){
        return;
    }

    const button =
        document.createElement(
            "button"
        );

    button.id =
        "archiveBackTop";

    button.className =
        "archive-back-top";

    button.type =
        "button";

    button.setAttribute(
        "aria-label",
        "Voltar ao topo"
    );

    button.innerHTML =
        "↑";

    button.addEventListener(
        "click",
        () => {

            window.scrollTo({
                top:0,
                behavior:"smooth"
            });

        }
    );

    document.body.appendChild(
        button
    );

}

/* =========================================================
   BOTÃO TOPO — VISIBILIDADE
   ========================================================= */

function updateArchiveBackTop(){

    const button =
        document.getElementById(
            "archiveBackTop"
        );

    if(!button){
        return;
    }

    if(
        window.scrollY > 450
    ){

        button.classList.add(
            "visible"
        );

    }else{

        button.classList.remove(
            "visible"
        );

    }

}

/* =========================================================
   SEÇÃO VISÍVEL
   ========================================================= */

function updateArchiveMobileActive(){

    const sections = [

        "home",
        "profile",
        "calendar",
        "status",
        "admin"

    ];

    const buttons =
        document.querySelectorAll(
            ".archive-mobile-nav-button"
        );

    let current =
        "home";

    const scrollPosition =
        window.scrollY + 180;

    sections.forEach(
        id => {

            const section =
                document.getElementById(
                    id
                );

            if(
                section &&
                section.offsetTop <=
                    scrollPosition
            ){

                current = id;

            }

        }
    );

    buttons.forEach(
        button => {

            button.classList.toggle(
                "active",
                button.dataset.target ===
                    current
            );

        }
    );

}

/* =========================================================
   NAVEGAÇÃO PRINCIPAL — LINKS EXISTENTES
   ========================================================= */

function improveArchiveNavigation(){

    const links =
        document.querySelectorAll(
            'a[href^="#"]'
        );

    links.forEach(
        link => {

            if(
                link.dataset.archiveNavReady
            ){
                return;
            }

            link.dataset.archiveNavReady =
                "true";

            link.addEventListener(
                "click",
                event => {

                    const id =
                        link
                            .getAttribute(
                                "href"
                            )
                            .replace(
                                "#",
                                ""
                            );

                    const target =
                        document.getElementById(
                            id
                        );

                    if(!target){
                        return;
                    }

                    event.preventDefault();

                    target.scrollIntoView({
                        behavior:"smooth",
                        block:"start"
                    });

                    /*
                       Atualiza a URL sem
                       recarregar a página.
                    */

                    try{

                        history.replaceState(
                            null,
                            "",
                            "#" + id
                        );

                    }catch(error){}

                }
            );

        }
    );

}

/* =========================================================
   ANIMAÇÃO DE ENTRADA
   ========================================================= */

function prepareArchiveReveal(){

    const elements =
        document.querySelectorAll(
            ".quick-card, " +
            ".member-card, " +
            ".calendar-card, " +
            ".stat-card, " +
            ".activity-card, " +
            ".admin-card"
        );

    if(
        !("IntersectionObserver" in window)
    ){
        return;
    }

    const observer =
        new IntersectionObserver(
            entries => {

                entries.forEach(
                    entry => {

                        if(
                            entry.isIntersecting
                        ){

                            entry.target.style.opacity =
                                "1";

                            entry.target.style.transform =
                                "translateY(0)";

                            observer.unobserve(
                                entry.target
                            );

                        }

                    }
                );

            },
            {
                threshold:.08
            }
        );

    elements.forEach(
        element => {

            /*
               Não aplicamos o efeito caso
               o usuário prefira menos movimento.
            */

            if(
                window.matchMedia(
                    "(prefers-reduced-motion: reduce)"
                ).matches
            ){

                return;

            }

            element.style.opacity =
                "0";

            element.style.transform =
                "translateY(8px)";

            element.style.transition =
                "opacity .5s ease, " +
                "transform .5s ease";

            observer.observe(
                element
            );

        }
    );

}

/* =========================================================
   ESCUTAR SCROLL
   ========================================================= */

let archiveScrollTick =
    false;

window.addEventListener(
    "scroll",
    () => {

        if(
            archiveScrollTick
        ){
            return;
        }

        archiveScrollTick =
            true;

        requestAnimationFrame(
            () => {

                updateArchiveBackTop();

                updateArchiveMobileActive();

                archiveScrollTick =
                    false;

            }
        );

    },
    {
        passive:true
    }
);

/* =========================================================
   INICIALIZAÇÃO
   ========================================================= */

document.addEventListener(
    "DOMContentLoaded",
    () => {

        setTimeout(
            () => {

                injectArchiveMobileNavigation();

                injectArchiveBackTop();

                improveArchiveNavigation();

                prepareArchiveReveal();

                updateArchiveBackTop();

                updateArchiveMobileActive();

            },
            700
        );

    }
);

/* =========================================================
   QUANDO NOVOS ELEMENTOS FOREM INSERIDOS
   ========================================================= */

const archiveNavigationObserver =
    new MutationObserver(
        () => {

            improveArchiveNavigation();

        }
    );

archiveNavigationObserver.observe(
    document.body,
    {
        childList:true,
        subtree:true
    }
);

/* =========================================================
   EXPORTAR
   ========================================================= */

window.injectArchiveMobileNavigation =
    injectArchiveMobileNavigation;

window.updateArchiveMobileActive =
    updateArchiveMobileActive;

</script>

