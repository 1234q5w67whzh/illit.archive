<html lang="pt-BR">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
  >

  <meta name="theme-color" content="#f5f5f7">

  <title>ILLIT Archive</title>

  <style>

    /* =====================================================
       ILLIT ARCHIVE
       PARTE 1 — BASE DO SITE
       ===================================================== */

    :root {
      --bg: #f5f5f7;
      --card: rgba(255, 255, 255, 0.72);
      --card-solid: #ffffff;
      --text: #111111;
      --secondary: #77777d;
      --border: rgba(0, 0, 0, 0.08);
      --shadow:
        0 10px 35px rgba(0, 0, 0, 0.07),
        0 2px 8px rgba(0, 0, 0, 0.04);

      --red: #ff3b30;
      --yellow: #ffcc00;
      --purple: #af8cff;
      --pink: #ffb6d9;
      --blue: #8ed8ff;

      --radius-large: 28px;
      --radius-medium: 20px;
      --radius-small: 14px;

      --max-width: 1180px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(
          circle at 15% 10%,
          rgba(255, 255, 255, 0.95),
          transparent 28%
        ),
        radial-gradient(
          circle at 85% 20%,
          rgba(220, 220, 225, 0.5),
          transparent 30%
        ),
        var(--bg);

      color: var(--text);

      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "SF Pro Display",
        "SF Pro Text",
        "Helvetica Neue",
        Arial,
        sans-serif;

      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    button,
    a,
    input,
    select,
    textarea {
      font: inherit;
    }

    button {
      border: 0;
      cursor: pointer;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      max-width: 100%;
      display: block;
    }

    /* =====================================================
       SCROLLBAR
       ===================================================== */

    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }

    ::-webkit-scrollbar-track {
      background: transparent;
    }

    ::-webkit-scrollbar-thumb {
      background: rgba(0, 0, 0, 0.16);
      border-radius: 999px;
    }

    /* =====================================================
       HEADER
       ===================================================== */

    .site-header {
      position: sticky;
      top: 0;
      z-index: 1000;

      width: 100%;

      background: rgba(245, 245, 247, 0.76);
      backdrop-filter: blur(24px) saturate(180%);
      -webkit-backdrop-filter: blur(24px) saturate(180%);

      border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    }

    .header-inner {
      width: min(100% - 32px, var(--max-width));
      min-height: 68px;
      margin: 0 auto;

      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;

      font-size: 17px;
      font-weight: 700;
      letter-spacing: -0.4px;

      white-space: nowrap;
    }

    .brand-icon {
      width: 34px;
      height: 34px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 11px;

      background: rgba(255, 255, 255, 0.9);

      box-shadow:
        0 5px 15px rgba(0, 0, 0, 0.08),
        inset 0 0 0 1px rgba(0, 0, 0, 0.04);

      font-size: 17px;
    }

    .main-nav {
      display: flex;
      align-items: center;
      gap: 4px;

      padding: 4px;

      background: rgba(0, 0, 0, 0.045);
      border-radius: 14px;
    }

    .nav-link {
      padding: 8px 13px;

      border-radius: 10px;

      color: var(--secondary);

      font-size: 13px;
      font-weight: 600;

      transition:
        background 0.2s ease,
        color 0.2s ease,
        transform 0.2s ease;
    }

    .nav-link:hover {
      color: var(--text);
      background: rgba(255, 255, 255, 0.8);
    }

    .nav-link:active {
      transform: scale(0.96);
    }

    /* =====================================================
       MAIN
       ===================================================== */

    main {
      width: min(100% - 32px, var(--max-width));
      margin: 0 auto;
    }

    /* =====================================================
       HOME HERO
       ===================================================== */

    .hero {
      min-height: 620px;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      text-align: center;

      padding: 80px 20px 100px;

      position: relative;
      overflow: hidden;
    }

    .hero-glow {
      position: absolute;

      width: 420px;
      height: 420px;

      border-radius: 50%;

      background:
        radial-gradient(
          circle,
          rgba(255, 255, 255, 0.95) 0%,
          rgba(255, 255, 255, 0.45) 38%,
          transparent 70%
        );

      filter: blur(10px);

      pointer-events: none;
    }

    .hero-sparkles {
      position: relative;
      z-index: 2;

      display: flex;
      align-items: center;
      justify-content: center;
      gap: 18px;

      margin-bottom: 24px;

      color: #b8b8bd;

      font-size: 20px;

      animation: floatingSparkles 4s ease-in-out infinite;
    }

    .hero-sparkles span:nth-child(2) {
      font-size: 30px;
    }

    .hero-sparkles span:nth-child(4) {
      font-size: 26px;
    }

    @keyframes floatingSparkles {
      0%,
      100% {
        transform: translateY(0);
        opacity: 0.8;
      }

      50% {
        transform: translateY(-6px);
        opacity: 1;
      }
    }

    .hero-eyebrow {
      position: relative;
      z-index: 2;

      margin-bottom: 12px;

      color: var(--secondary);

      font-size: 13px;
      font-weight: 600;

      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .hero-title {
      position: relative;
      z-index: 2;

      font-size: clamp(68px, 15vw, 150px);
      line-height: 0.9;

      font-weight: 800;
      letter-spacing: -7px;

      background:
        linear-gradient(
          180deg,
          #111111 0%,
          #4b4b4f 100%
        );

      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .hero-subtitle {
      position: relative;
      z-index: 2;

      max-width: 520px;

      margin-top: 24px;

      color: var(--secondary);

      font-size: 17px;
      line-height: 1.5;

      letter-spacing: -0.2px;
    }

    /* =====================================================
       MEMBER ORBIT / INTRO
       ===================================================== */

    .member-row {
      position: relative;
      z-index: 2;

      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;

      margin-top: 32px;
    }

    .member-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;

      padding: 8px 12px;

      background: rgba(255, 255, 255, 0.66);
      backdrop-filter: blur(15px);
      -webkit-backdrop-filter: blur(15px);

      border: 1px solid rgba(0, 0, 0, 0.055);

      border-radius: 999px;

      box-shadow:
        0 5px 18px rgba(0, 0, 0, 0.045);

      color: var(--secondary);

      font-size: 12px;
      font-weight: 600;

      transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
    }

    .member-pill:hover {
      transform: translateY(-3px);

      box-shadow:
        0 10px 24px rgba(0, 0, 0, 0.08);
    }

    .member-pill span {
      font-size: 15px;
    }

    /* =====================================================
       SECTION BASE
       ===================================================== */

    .section {
      padding: 80px 0;
    }

    .section-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px;

      margin-bottom: 28px;
    }

    .section-kicker {
      margin-bottom: 7px;

      color: var(--secondary);

      font-size: 12px;
      font-weight: 700;

      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .section-title {
      font-size: clamp(32px, 6vw, 52px);
      line-height: 1;

      font-weight: 750;
      letter-spacing: -2px;
    }

    .section-description {
      max-width: 440px;

      margin-top: 12px;

      color: var(--secondary);

      font-size: 15px;
      line-height: 1.5;
    }

    /* =====================================================
       IOS CARD
       ===================================================== */

    .ios-card {
      background: var(--card);

      backdrop-filter: blur(25px) saturate(150%);
      -webkit-backdrop-filter: blur(25px) saturate(150%);

      border: 1px solid rgba(255, 255, 255, 0.75);

      border-radius: var(--radius-large);

      box-shadow: var(--shadow);
    }

    /* =====================================================
       QUICK ACCESS
       ===================================================== */

    .quick-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .quick-card {
      min-height: 190px;

      padding: 24px;

      display: flex;
      flex-direction: column;
      justify-content: space-between;

      transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
    }

    .quick-card:hover {
      transform: translateY(-5px);

      box-shadow:
        0 18px 40px rgba(0, 0, 0, 0.1);
    }

    .quick-icon {
      width: 44px;
      height: 44px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 14px;

      background: rgba(0, 0, 0, 0.045);

      font-size: 21px;
    }

    .quick-title {
      margin-top: 18px;

      font-size: 18px;
      font-weight: 700;

      letter-spacing: -0.5px;
    }

    .quick-text {
      margin-top: 6px;

      color: var(--secondary);

      font-size: 13px;
      line-height: 1.4;
    }

    .quick-arrow {
      align-self: flex-end;

      color: #8b8b91;

      font-size: 20px;
    }

    /* =====================================================
       MEMBER COLORS
       ===================================================== */

    .yunah {
      --member-color: var(--red);
    }

    .minju {
      --member-color: var(--yellow);
    }

    .moka {
      --member-color: var(--purple);
    }

    .wonhee {
      --member-color: var(--pink);
    }

    .iroha {
      --member-color: var(--blue);
    }

    /* =====================================================
       ANIMATION
       ===================================================== */

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(16px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-in {
      animation: fadeUp 0.7s ease both;
    }

    /* =====================================================
       MOBILE
       ===================================================== */

    @media (max-width: 760px) {

      .header-inner {
        min-height: 62px;
      }

      .brand {
        font-size: 15px;
      }

      .brand-icon {
        width: 31px;
        height: 31px;
        border-radius: 10px;
      }

      .main-nav {
        max-width: 60vw;
        overflow-x: auto;

        scrollbar-width: none;
      }

      .main-nav::-webkit-scrollbar {
        display: none;
      }

      .nav-link {
        padding: 8px 10px;
        font-size: 11px;
        white-space: nowrap;
      }

      .hero {
        min-height: 560px;
        padding: 70px 10px 80px;
      }

      .hero-title {
        letter-spacing: -5px;
      }

      .hero-subtitle {
        font-size: 15px;
        max-width: 340px;
      }

      .member-row {
        max-width: 340px;
      }

      .member-pill {
        padding: 7px 10px;
      }

      .section {
        padding: 60px 0;
      }

      .section-header {
        display: block;
      }

      .quick-grid {
        grid-template-columns: 1fr;
      }

      .quick-card {
        min-height: 160px;
      }
    }

    /* =====================================================
       REDUCED MOTION
       ===================================================== */

    @media (prefers-reduced-motion: reduce) {

      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

  </style>

</head>

