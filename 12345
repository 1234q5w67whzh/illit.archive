<script>
/* =========================================================
   SINCRONIZAÇÃO GERAL
   ========================================================= */

/* ---------- CHAVES ---------- */

const ARCHIVE_ACTIVITY_KEY =
    "illitArchiveActivities";

const ARCHIVE_PROFILE_KEY =
    "illitMemberProfiles";

const ARCHIVE_SYNC_KEY =
    "illitArchiveLastSync";

/* =========================================================
   INDICADOR
   ========================================================= */

let archiveSyncTimer = null;

function showArchiveSyncIndicator(){

    let indicator =
        document.getElementById(
            "archiveSyncIndicator"
        );

    if(!indicator){

        indicator =
            document.createElement("div");

        indicator.id =
            "archiveSyncIndicator";

        indicator.className =
            "archive-sync-indicator";

        indicator.innerHTML = `

            <span class="archive-sync-dot"></span>

            <span>
                Arquivo atualizado
            </span>

        `;

        document.body.appendChild(
            indicator
        );

    }

    indicator.classList.add(
        "visible"
    );

    clearTimeout(
        archiveSyncTimer
    );

    archiveSyncTimer =
        setTimeout(() => {

            indicator.classList.remove(
                "visible"
            );

        },1800);

}

/* =========================================================
   CARREGAR ATIVIDADES
   ========================================================= */

function loadArchiveActivities(){

    try{

        const saved =
            localStorage.getItem(
                ARCHIVE_ACTIVITY_KEY
            );

        if(saved){

            const parsed =
                JSON.parse(saved);

            if(Array.isArray(parsed)){
                return parsed;
            }

        }

    }catch(error){

        console.warn(
            "Não foi possível carregar atividades.",
            error
        );

    }

    /*
       Se ainda não houver dados no localStorage,
       usamos os dados iniciais do calendário.
    */

    if(
        typeof calendarActivities !==
        "undefined"
    ){

        return Array.isArray(
            calendarActivities
        )
            ? calendarActivities
            : [];

    }

    return [];

}

/* =========================================================
   CARREGAR PERFIS
   ========================================================= */

function loadArchiveProfiles(){

    try{

        const saved =
            localStorage.getItem(
                ARCHIVE_PROFILE_KEY
            );

        if(saved){

            const parsed =
                JSON.parse(saved);

            if(
                parsed &&
                typeof parsed === "object"
            ){
                return parsed;
            }

        }

    }catch(error){

        console.warn(
            "Não foi possível carregar perfis.",
            error
        );

    }

    return {};
}

/* =========================================================
   SALVAR ATIVIDADES
   ========================================================= */

function persistArchiveActivities(
    activities
){

    localStorage.setItem(
        ARCHIVE_ACTIVITY_KEY,
        JSON.stringify(
            Array.isArray(activities)
                ? activities
                : []
        )
    );

    localStorage.setItem(
        ARCHIVE_SYNC_KEY,
        new Date().toISOString()
    );

}

/* =========================================================
   NORMALIZAR TODOS OS DADOS
   ========================================================= */

function normalizeEntireArchive(){

    const activities =
        loadArchiveActivities();

    const normalized =
        activities.map(activity => {

            return normalizeAdminActivity(
                activity
            );

        });

    persistArchiveActivities(
        normalized
    );

    return normalized;

}

/* =========================================================
   ATUALIZAR CALENDÁRIO
   ========================================================= */

function syncArchiveCalendar(){

    const activities =
        loadArchiveActivities();

    /*
       O calendário público passa a utilizar
       diretamente os dados do arquivo.
    */

    window.archiveCalendarActivities =
        activities;

    /*
       Mantemos a variável antiga para
       compatibilidade com as partes anteriores.
    */

    try{

        if(
            typeof calendarActivities !==
            "undefined"
        ){

            calendarActivities.length = 0;

            activities.forEach(activity => {

                calendarActivities.push(
                    activity
                );

            });

        }

    }catch(error){}

    if(
        typeof syncCalendarInterface ===
        "function"
    ){

        try{
            syncCalendarInterface();
        }catch(error){
            console.warn(
                "Erro ao sincronizar calendário.",
                error
            );
        }

    }

}

/* =========================================================
   ATUALIZAR HOME
   ========================================================= */

function syncArchiveHome(){

    if(
        typeof renderHomeDynamic ===
        "function"
    ){

        try{
            renderHomeDynamic();
        }catch(error){
            console.warn(
                "Erro ao atualizar Home.",
                error
            );
        }

    }

}

/* =========================================================
   ATUALIZAR PERFIS
   ========================================================= */

function syncArchiveProfiles(){

    if(
        typeof refreshMemberProfiles ===
        "function"
    ){

        try{
            refreshMemberProfiles();
        }catch(error){
            console.warn(
                "Erro ao atualizar perfis.",
                error
            );
        }

    }

    if(
        typeof renderAdminProfileEditors ===
        "function"
    ){

        try{
            renderAdminProfileEditors();
        }catch(error){}

    }

}

/* =========================================================
   ATUALIZAR ESTATÍSTICAS
   ========================================================= */

function syncArchiveStatistics(){

    /*
       Algumas partes anteriores possuem
       funções diferentes para as estatísticas.
       Tentamos todas as disponíveis.
    */

    const possibleFunctions = [

        "updateArchiveStats",
        "renderStatistics",
        "updateStatistics",
        "renderStatusStatistics"

    ];

    possibleFunctions.forEach(
        functionName => {

            if(
                typeof window[
                    functionName
                ] === "function"
            ){

                try{

                    window[
                        functionName
                    ]();

                }catch(error){

                    console.warn(
                        "Erro em " +
                        functionName,
                        error
                    );

                }

            }

        }
    );

}

/* =========================================================
   ATUALIZAR ADMIN
   ========================================================= */

function syncArchiveAdmin(){

    if(
        typeof updateAdminDashboardStats ===
        "function"
    ){

        try{
            updateAdminDashboardStats();
        }catch(error){}

    }

    if(
        typeof renderAdminActivityList ===
        "function"
    ){

        try{
            renderAdminActivityList();
        }catch(error){}

    }

}

/* =========================================================
   SINCRONIZAÇÃO COMPLETA
   ========================================================= */

function synchronizeEntireArchive(
    showIndicator = true
){

    /*
       1. Normaliza
    */

    normalizeEntireArchive();

    /*
       2. Calendário
    */

    syncArchiveCalendar();

    /*
       3. Home
    */

    syncArchiveHome();

    /*
       4. Perfis
    */

    syncArchiveProfiles();

    /*
       5. Estatísticas
    */

    syncArchiveStatistics();

    /*
       6. Admin
    */

    syncArchiveAdmin();

    /*
       7. Última sincronização
    */

    localStorage.setItem(
        ARCHIVE_SYNC_KEY,
        new Date().toISOString()
    );

    if(showIndicator){

        showArchiveSyncIndicator();

    }

}

/* =========================================================
   ÚLTIMA ATUALIZAÇÃO
   ========================================================= */

function getArchiveLastSync(){

    return localStorage.getItem(
        ARCHIVE_SYNC_KEY
    );

}

/* =========================================================
   TEXTO DA ÚLTIMA ATUALIZAÇÃO
   ========================================================= */

function formatArchiveLastSync(){

    const value =
        getArchiveLastSync();

    if(!value){
        return "Ainda não sincronizado";
    }

    const date =
        new Date(value);

    if(Number.isNaN(date.getTime())){
        return "Ainda não sincronizado";
    }

    return date.toLocaleString(
        "pt-BR",
        {
            day:"2-digit",
            month:"2-digit",
            year:"numeric",
            hour:"2-digit",
            minute:"2-digit"
        }
    );

}

/* =========================================================
   BOTÃO MANUAL DE ATUALIZAÇÃO
   ========================================================= */

function createArchiveRefreshButton(){

    if(
        document.getElementById(
            "archiveManualRefresh"
        )
    ){
        return;
    }

    const admin =
        document.getElementById(
            "admin"
        );

    if(!admin) return;

    const button =
        document.createElement("button");

    button.id =
        "archiveManualRefresh";

    button.type =
        "button";

    button.className =
        "archive-refresh-button";

    button.innerHTML = `
        <span>↻</span>
        <span>Atualizar arquivo</span>
    `;

    button.onclick = function(){

        button.classList.add(
            "spinning"
        );

        synchronizeEntireArchive(
            true
        );

        setTimeout(() => {

            button.classList.remove(
                "spinning"
            );

        },700);

    };

    /*
       Colocamos no começo do Admin.
    */

    admin.prepend(button);

    const update =
        document.createElement("div");

    update.id =
        "archiveLastUpdate";

    update.className =
        "archive-last-update";

    update.textContent =
        "Última atualização: " +
        formatArchiveLastSync();

    button.insertAdjacentElement(
        "afterend",
        update
    );

}

/* =========================================================
   ATUALIZAR TEXTO DA DATA
   ========================================================= */

function updateArchiveLastSyncText(){

    const element =
        document.getElementById(
            "archiveLastUpdate"
        );

    if(!element) return;

    element.textContent =
        "Última atualização: " +
        formatArchiveLastSync();

}

/* =========================================================
   ESCUTAR STORAGE
   ========================================================= */

window.addEventListener(
    "storage",
    event => {

        if(
            event.key ===
                ARCHIVE_ACTIVITY_KEY ||
            event.key ===
                ARCHIVE_PROFILE_KEY
        ){

            synchronizeEntireArchive(
                false
            );

            updateArchiveLastSyncText();

        }

    }
);

/* =========================================================
   INTERCEPTAR SALVAMENTO DE ATIVIDADE
   ========================================================= */

(function(){

    const originalSave =
        window.saveAdminActivities;

    if(
        typeof originalSave !==
            "function" ||
        originalSave.__archiveSyncWrapped
    ){
        return;
    }

    const wrapped =
        function(activities){

            const result =
                originalSave.apply(
                    this,
                    arguments
                );

            setTimeout(() => {

                synchronizeEntireArchive(
                    true
                );

                updateArchiveLastSyncText();

            },80);

            return result;

        };

    wrapped.__archiveSyncWrapped =
        true;

    window.saveAdminActivities =
        wrapped;

})();

/* =========================================================
   OBSERVAR MUDANÇAS DE LOCALSTORAGE
   ========================================================= */

function watchArchiveData(){

    /*
       Não fazemos polling constante.
       O evento "storage" cuida de alterações
       vindas de outras abas.

       Aqui fazemos apenas uma verificação
       inicial para garantir que as partes
       estejam sincronizadas.
    */

    setTimeout(() => {

        synchronizeEntireArchive(
            false
        );

        updateArchiveLastSyncText();

    },500);

}

/* =========================================================
   INICIALIZAÇÃO
   ========================================================= */

document.addEventListener(
    "DOMContentLoaded",
    () => {

        setTimeout(() => {

            createArchiveRefreshButton();

            watchArchiveData();

        },300);

    }
);

/* =========================================================
   EXPORTAR
   ========================================================= */

window.loadArchiveActivities =
    loadArchiveActivities;

window.loadArchiveProfiles =
    loadArchiveProfiles;

window.syncArchiveCalendar =
    syncArchiveCalendar;

window.syncArchiveHome =
    syncArchiveHome;

window.syncArchiveProfiles =
    syncArchiveProfiles;

window.syncArchiveStatistics =
    syncArchiveStatistics;

window.syncArchiveAdmin =
    syncArchiveAdmin;

window.synchronizeEntireArchive =
    synchronizeEntireArchive;

</script>

