<script>
/* =========================================================
   HOME DINÂMICA
   ========================================================= */

/* ---------- DADOS ---------- */

function getHomeActivities(){

    if(typeof getArchiveCalendarActivities === "function"){

        const activities = getArchiveCalendarActivities();

        if(Array.isArray(activities)){
            return activities;
        }

    }

    if(typeof calendarActivities !== "undefined"){
        return calendarActivities || [];
    }

    return [];
}

/* ---------- DATA ---------- */

function homeDateValue(activity){

    const value =
        activity.startDate ||
        activity.date ||
        activity.start ||
        "";

    if(!value) return null;

    const date = new Date(value);

    if(Number.isNaN(date.getTime())) return null;

    return date;
}

/* ---------- ORDEM ---------- */

function sortHomeActivities(activities){

    return [...activities].sort((a,b) => {

        const da = homeDateValue(a);
        const db = homeDateValue(b);

        if(!da && !db) return 0;
        if(!da) return 1;
        if(!db) return -1;

        return da - db;

    });

}

/* ---------- MEMBRO ---------- */

function getHomeMemberInfo(member){

    const data = {
        all:{
            name:"ILLIT",
            emoji:"✨",
            heart:"",
            color:"#8e8e93",
            soft:"rgba(142,142,147,.14)"
        },

        YUNAH:{
            name:"YUNAH",
            emoji:"🐆",
            heart:"❤️",
            color:"#ff4f5e",
            soft:"rgba(255,79,94,.14)"
        },

        MINJU:{
            name:"MINJU",
            emoji:"🐰",
            heart:"💛",
            color:"#d6ad22",
            soft:"rgba(242,201,76,.17)"
        },

        MOKA:{
            name:"MOKA",
            emoji:"☕️",
            heart:"💜",
            color:"#a579f4",
            soft:"rgba(178,140,255,.16)"
        },

        WONHEE:{
            name:"WONHEE",
            emoji:"🐿️",
            heart:"🩷",
            color:"#ff83b4",
            soft:"rgba(255,158,196,.17)"
        },

        IROHA:{
            name:"IROHA",
            emoji:"🐢",
            heart:"🩵",
            color:"#51bdd5",
            soft:"rgba(117,216,237,.17)"
        }
    };

    return data[member] || data.all;
}

/* ---------- STATUS ---------- */

function getHomeStatusClass(status){

    const value = String(status || "")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g,"");

    if(value.includes("cancel")){
        return "home-status-cancelled";
    }

    if(value.includes("tbc") || value.includes("pend")){
        return "home-status-tbc";
    }

    if(value.includes("complete")){
        return "home-status-completed";
    }

    return "home-status-confirmed";
}

/* ---------- STATUS TEXTO ---------- */

function getHomeStatusText(status){

    if(!status) return "Confirmado";

    const value = String(status)
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g,"");

    if(value.includes("cancel")) return "Cancelado";
    if(value.includes("tbc")) return "TBC";
    if(value.includes("pend")) return "Pendente";
    if(value.includes("complete")) return "Concluído";

    return "Confirmado";
}

/* ---------- DATA FORMATADA ---------- */

function formatHomeDate(date){

    if(!date) return "Data não definida";

    return date.toLocaleDateString("pt-BR",{
        weekday:"short",
        day:"2-digit",
        month:"short"
    });

}

/* ---------- HORA ---------- */

function getHomeTime(activity){

    if(activity.startTime){
        return activity.startTime;
    }

    if(activity.time){
        return activity.time;
    }

    return "";

}

/* =========================================================
   ENCONTRAR PRÓXIMO EVENTO
   ========================================================= */

function getNextHomeActivity(){

    const now = new Date();

    const activities = sortHomeActivities(
        getHomeActivities()
    );

    const future = activities.filter(activity => {

        const date = homeDateValue(activity);

        if(!date) return false;

        const status = String(activity.status || "")
            .toLowerCase();

        if(status.includes("cancel")){
            return false;
        }

        return date >= new Date(
            now.getFullYear(),
            now.getMonth(),
            now.getDate()
        );

    });

    return future[0] || null;

}

/* =========================================================
   RENDER DO PRÓXIMO EVENTO
   ========================================================= */

function renderNextHomeActivity(){

    const container =
        document.getElementById("homeNextActivity");

    if(!container) return;

    const activity = getNextHomeActivity();

    if(!activity){

        container.innerHTML = `
            <div class="home-empty">
                <div class="home-empty-icon">✨</div>

                <div class="home-empty-title">
                    Nenhuma atividade próxima
                </div>

                <div class="home-empty-text">
                    Novas atividades aparecerão aqui.
                </div>
            </div>
        `;

        return;
    }

    const member =
        getHomeMemberInfo(
            activity.member ||
            activity.who ||
            "all"
        );

    const date = homeDateValue(activity);

    const title =
        activity.title ||
        activity.name ||
        "Atividade";

    const location =
        activity.location ||
        activity.city ||
        "";

    const time =
        getHomeTime(activity);

    const status =
        getHomeStatusText(activity.status);

    const statusClass =
        getHomeStatusClass(activity.status);

    container.innerHTML = `

        <div
            class="next-event-card"
            style="--home-member-color:${member.color};"
            onclick="openEventModal && openEventModal(${JSON.stringify(activity).replace(/"/g,'&quot;')})"
        >

            <div
                class="next-event-glow"
                style="background:${member.color};"
            ></div>

            <div class="next-event-member">

                <span>${member.emoji}</span>

                <span>${member.name}</span>

                ${member.heart
                    ? `<span>${member.heart}</span>`
                    : ""
                }

            </div>

            <div class="next-event-title">
                ${escapeHomeText(title)}
            </div>

            <div class="next-event-date">

                <span>📅</span>

                <span>
                    ${formatHomeDate(date)}
                    ${time ? " • " + escapeHomeText(time) : ""}
                </span>

            </div>

            ${
                location
                ? `
                    <div class="next-event-location">
                        📍 ${escapeHomeText(location)}
                    </div>
                `
                : ""
            }

            <div class="home-status ${statusClass}">
                ${status}
            </div>

        </div>
    `;

}

/* =========================================================
   ESCAPE
   ========================================================= */

function escapeHomeText(value){

    return String(value ?? "")
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}

/* =========================================================
   PRÓXIMAS 5 ATIVIDADES
   ========================================================= */

function renderHomeUpcoming(){

    const container =
        document.getElementById("homeUpcomingActivities");

    if(!container) return;

    const activities =
        sortHomeActivities(
            getHomeActivities()
        );

    const today = new Date();

    const upcoming = activities
        .filter(activity => {

            const date = homeDateValue(activity);

            if(!date) return false;

            const status =
                String(activity.status || "")
                    .toLowerCase();

            if(status.includes("cancel")){
                return false;
            }

            return date >= new Date(
                today.getFullYear(),
                today.getMonth(),
                today.getDate()
            );

        })
        .slice(0,5);

    if(!upcoming.length){

        container.innerHTML = `
            <div class="home-empty">
                <div class="home-empty-icon">🗓️</div>
                <div class="home-empty-title">
                    Calendário vazio
                </div>
                <div class="home-empty-text">
                    Adicione atividades pelo painel Admin.
                </div>
            </div>
        `;

        return;
    }

    container.innerHTML = upcoming.map(activity => {

        const member =
            getHomeMemberInfo(
                activity.member ||
                activity.who ||
                "all"
            );

        const date =
            homeDateValue(activity);

        const title =
            activity.title ||
            activity.name ||
            "Atividade";

        const time =
            getHomeTime(activity);

        return `

            <div
                class="home-activity-item"
                onclick="openEventModal && openEventModal(${JSON.stringify(activity).replace(/"/g,'&quot;')})"
            >

                <div
                    class="home-activity-icon"
                    style="
                        background:${member.soft};
                        color:${member.color};
                    "
                >
                    ${member.emoji}
                </div>

                <div class="home-activity-content">

                    <div class="home-activity-name">
                        ${escapeHomeText(title)}
                    </div>

                    <div class="home-activity-meta">

                        ${member.name}
                        •
                        ${formatHomeDate(date)}

                        ${time
                            ? " • " + escapeHomeText(time)
                            : ""
                        }

                    </div>

                </div>

                <div class="home-activity-arrow">
                    ›
                </div>

            </div>

        `;

    }).join("");

}

/* =========================================================
   CONTADOR TOTAL
   ========================================================= */

function renderHomeTotal(){

    const container =
        document.getElementById("homeTotalActivities");

    if(!container) return;

    const activities = getHomeActivities();

    const valid =
        activities.filter(activity =>
            !String(activity.status || "")
                .toLowerCase()
                .includes("cancel")
        );

    container.textContent = valid.length;

}

/* =========================================================
   MEMBROS ATIVOS
   ========================================================= */

function renderHomeMemberCount(){

    const container =
        document.getElementById("homeMemberCount");

    if(!container) return;

    const members = new Set();

    getHomeActivities().forEach(activity => {

        const member =
            activity.member ||
            activity.who;

        if(
            member &&
            member !== "all"
        ){
            members.add(member);
        }

    });

    container.textContent =
        members.size || "0";

}

/* =========================================================
   PRÓXIMO MÊS
   ========================================================= */

function renderHomeNextMonth(){

    const container =
        document.getElementById("homeNextMonth");

    if(!container) return;

    const now = new Date();

    const nextMonth =
        new Date(
            now.getFullYear(),
            now.getMonth() + 1,
            1
        );

    const nextMonthActivities =
        getHomeActivities().filter(activity => {

            const date =
                homeDateValue(activity);

            if(!date) return false;

            return (
                date.getFullYear() ===
                    nextMonth.getFullYear() &&
                date.getMonth() ===
                    nextMonth.getMonth()
            );

        });

    container.textContent =
        nextMonthActivities.length;

}

/* =========================================================
   CRIAR BLOCO NA HOME
   ========================================================= */

function injectHomeDynamicContent(){

    const home =
        document.getElementById("home");

    if(!home) return;

    if(document.getElementById("homeDynamicSection")){
        return;
    }

    const section =
        document.createElement("div");

    section.id = "homeDynamicSection";

    section.className =
        "home-live-wrapper";

    section.innerHTML = `

        <div>

            <div class="home-ios-card">

                <div class="home-card-title">
                    ATIVIDADES
                </div>

                <div
                    class="home-card-main"
                    id="homeTotalActivities"
                >
                    0
                </div>

                <div class="home-card-sub">
                    atividades registradas no arquivo
                </div>

            </div>

            <div style="height:12px"></div>

            <div class="home-ios-card">

                <div class="home-card-title">
                    MEMBROS
                </div>

                <div
                    class="home-card-main"
                    id="homeMemberCount"
                >
                    0
                </div>

                <div class="home-card-sub">
                    membros com atividades registradas
                </div>

            </div>

            <div style="height:12px"></div>

            <div class="home-ios-card">

                <div class="home-card-title">
                    PRÓXIMO MÊS
                </div>

                <div
                    class="home-card-main"
                    id="homeNextMonth"
                >
                    0
                </div>

                <div class="home-card-sub">
                    atividades previstas
                </div>

            </div>

        </div>

        <div>

            <div class="home-card-title"
                 style="margin:0 0 8px 3px;">
                PRÓXIMA ATIVIDADE
            </div>

            <div id="homeNextActivity"></div>

        </div>

    `;

    /*
       Coloca o bloco no final da seção Home,
       sem apagar o conteúdo que já existe.
    */

    home.appendChild(section);

    /* ---------- LISTA ---------- */

    const listSection =
        document.createElement("div");

    listSection.id =
        "homeUpcomingSection";

    listSection.style.marginTop = "18px";

    listSection.innerHTML = `

        <div class="home-ios-card">

            <div class="home-card-title">
                PRÓXIMAS ATIVIDADES
            </div>

            <div
                class="home-card-main"
                style="font-size:18px;"
            >
                Agenda
            </div>

            <div
                id="homeUpcomingActivities"
                class="home-activity-list"
            ></div>

        </div>

    `;

    home.appendChild(listSection);

}

/* =========================================================
   RENDER COMPLETO
   ========================================================= */

function renderHomeDynamic(){

    injectHomeDynamicContent();

    renderHomeTotal();

    renderHomeMemberCount();

    renderHomeNextMonth();

    renderNextHomeActivity();

    renderHomeUpcoming();

}

/* =========================================================
   ATUALIZAÇÃO
   ========================================================= */

window.refreshHomeDynamic =
    renderHomeDynamic;

window.addEventListener("storage", event => {

    if(
        event.key === "illitArchiveActivities" ||
        event.key === "illitMemberProfiles"
    ){

        setTimeout(() => {
            renderHomeDynamic();
        },50);

    }

});

/* =========================================================
   INICIALIZAÇÃO
   ========================================================= */

document.addEventListener("DOMContentLoaded", () => {

    setTimeout(() => {

        renderHomeDynamic();

    },100);

});

/* =========================================================
   INTEGRAR COM SALVAMENTO DO ADMIN
   ========================================================= */

const oldFinishSavingActivity =
    window.finishSavingActivity;

if(
    typeof oldFinishSavingActivity === "function" &&
    !oldFinishSavingActivity.__homeWrapped
){

    const wrappedFinishSavingActivity =
        function(){

            const result =
                oldFinishSavingActivity.apply(
                    this,
                    arguments
                );

            setTimeout(() => {

                renderHomeDynamic();

                if(
                    typeof syncCalendarInterface ===
                    "function"
                ){
                    syncCalendarInterface();
                }

            },100);

            return result;

        };

    wrappedFinishSavingActivity.__homeWrapped = true;

    window.finishSavingActivity =
        wrappedFinishSavingActivity;

}

</script>

