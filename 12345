/* =========================================================
   INTEGRAR COM O CALENDÁRIO EXISTENTE
   ========================================================= */

function syncCalendarInterface() {

  /*
    Atualiza o array antigo.
  */

  const activities =
    getArchiveCalendarActivities();

  if (
    typeof calendarActivities !== "undefined" &&
    Array.isArray(calendarActivities)
  ) {

    calendarActivities.length = 0;

    activities.forEach(activity => {

      calendarActivities.push(
        activity
      );

