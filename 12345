            ></div>

            <div
                id="advancedStatsLegend"
                class="archive-stats-legend"
            ></div>

        </div>

        <div
            id="advancedStatsAlert"
            class="archive-stat-alert"
        ></div>

    `;

    status.appendChild(
        panel
    );

}

/* =========================================================
   FILTROS AVANÇADOS
   ========================================================= */

function injectAdvancedStatsFilters(){

    const status =
        document.getElementById(
            "status"
        );

    if(!status){
        return;
    }

    if(
        document.getElementById(
            "advancedStatsFilters"
        )
    ){
        return;
    }

    const panel =
        document.createElement(
            "div"
        );

    panel.id =
        "advancedStatsFilters";

    panel.className =
        "archive-stats-filter-panel";

    panel.innerHTML = `

        <select
            id="advancedStatsMonth"
            class="archive-stats-filter"
        >

            <option value="all">
                Todos os meses
            </option>

            <option value="01">Janeiro</option>
            <option value="02">Fevereiro</option>
            <option value="03">Março</option>
            <option value="04">Abril</option>
            <option value="05">Maio</option>
            <option value="06">Junho</option>
            <option value="07">Julho</option>
            <option value="08">Agosto</option>
            <option value="09">Setembro</option>
            <option value="10">Outubro</option>
            <option value="11">Novembro</option>
            <option value="12">Dezembro</option>

        </select>

        <select
            id="advancedStatsYear"
            class="archive-stats-filter"
        >

            <option value="all">
                Todos os anos
            </option>

        </select>

        <select
            id="advancedStatsType"
            class="archive-stats-filter"
        >

            <option value="all">
                Todos os tipos
            </option>

            <option value="show">
                Show
            </option>

            <option value="festival">
                Festival
            </option>

            <option value="event">
                Evento
            </option>

            <option value="tv">
                TV
            </option>

            <option value="radio">
                Rádio
            </option>

            <option value="interview">
                Entrevista
            </option>

            <option value="photoshoot">
                Photoshoot
            </option>

            <option value="advertisement">
                Publicidade
            </option>

            <option value="fansign">
                Fansign
            </option>

            <option value="content">
                Conteúdo
            </option>

            <option value="release">
                Release
            </option>

            <option value="other">
                Outro
            </option>

        </select>

    `;

    /*
       Inserimos antes do painel avançado.
    */

    status.appendChild(
        panel
    );

    [
        "advancedStatsMonth",
        "advancedStatsYear",
        "advancedStatsType"

    ].forEach(id => {

        const select =
