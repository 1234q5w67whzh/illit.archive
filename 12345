      activity.startTime ||
      "",

    endTime:
      activity.endTime ||
      "",

    location:
      activity.location ||
      "",

    city:
      activity.city ||
      "",

    country:
      activity.country ||
      "",

    status:
      activity.status ||
      "Confirmed",

    officialLink:
      activity.officialLink ||
      "",

    streamLink:
      activity.streamLink ||
