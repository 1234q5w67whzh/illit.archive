            );

        }

    });

}

/* =========================================================
   PREENCHER ANOS
   ========================================================= */

function populateAdvancedStatsYears(){

    const select =
        document.getElementById(
            "advancedStatsYear"
        );

    if(!select){
        return;
    }

    const activities =
        getAdvancedStatsActivities();

    const years =
        new Set();

    activities.forEach(
        activity => {

            const date =
                advancedStatsDate(
                    activity
                );

            if(date){

                years.add(
                    date.getFullYear()
                );

            }

        }
    );

    const sortedYears =
        [...years].sort(
            (a,b) => b-a
        );

    const current =
        select.value;

    select.innerHTML = `

        <option value="all">
            Todos os anos
        </option>

    `;

    sortedYears.forEach(
        year => {

            const option =
                document.createElement(
                    "option"
                );

            option.value =
                String(year);

            option.textContent =
                String(year);

            select.appendChild(
                option
            );

        }
    );

    if(
        sortedYears.includes(
            Number(current)
        )
    ){

        select.value =
            current;

    }

}

/* =========================================================
   TIMELINE
   ========================================================= */

function renderAdvancedTimeline(
    activities
){

    const container =
        document.getElementById(
            "advancedStatsTimeline"
        );

    if(!container){
        return;
    }

    const filters =
        getAdvancedStatsFilters();

    const buckets = {};

    /*
       Se um ano específico estiver selecionado,
       mostramos os meses.

       Caso contrário, mostramos os anos.
    */

    if(
        filters.year !== "all"
    ){

        for(
            let month = 1;
            month <= 12;
            month++
        ){

            buckets[
                String(month)
                    .padStart(2,"0")
            ] = 0;

        }

        activities.forEach(
            activity => {

                const date =
                    advancedStatsDate(
                        activity
                    );

                if(!date) return;

                const key =
                    String(
                        date.getMonth()+1
                    ).padStart(
                        2,
                        "0"
                    );

                buckets[key]++;

            }
        );

    }else{

        const years =
            new Set();

        activities.forEach(
            activity => {

                const date =
                    advancedStatsDate(
                        activity
                    );

                if(date){

                    years.add(
                        date.getFullYear()
                    );

                }

            }
        );

        [...years]
            .sort((a,b)=>a-b)
            .forEach(
                year => {

                    buckets[
                        String(year)
                    ] = 0;

                }
            );

        activities.forEach(
            activity => {

                const date =
                    advancedStatsDate(
                        activity
                    );

                if(!date) return;

                const key =
                    String(
                        date.getFullYear()
                    );

                if(
                    Object.prototype
                        .hasOwnProperty.call(
                            buckets,
                            key
                        )
                ){

                    buckets[key]++;

                }

            }
        );

    }

    const values =
        Object.values(
            buckets
        );

    const max =
        Math.max(
            ...values,
            1
        );

    container.innerHTML = "";

    Object.entries(
        buckets
    ).forEach(
        ([key,value]) => {

            const column =
                document.createElement(
                    "div"
                );

            column.className =
                "archive-timeline-column";

            const valueLabel =
                document.createElement(
                    "div"
                );

            valueLabel.className =
                "archive-timeline-value";

            valueLabel.textContent =
                value;

            const bar =
                document.createElement(
                    "div"
                );

            bar.className =
                "archive-timeline-bar";

            /*
               A altura mínima mantém o gráfico
               visível mesmo quando o valor é 0.
            */

            const height =
                value === 0
                    ? 3
                    : Math.max(
                        10,
                        (value/max)*130
                    );

            bar.style.height =
                height + "px";

            /*
               Cor neutra do gráfico geral.
            */

            bar.style.background =
                "rgba(120,120,128,.42)";

            const label =
                document.createElement(
                    "div"
                );

            label.className =
                "archive-timeline-label";

            if(
                filters.year !== "all"
            ){

                const monthNumber =
                    Number(key);

                const names = [
                    "Jan",
                    "Fev",
                    "Mar",
                    "Abr",
                    "Mai",
                    "Jun",
                    "Jul",
                    "Ago",
                    "Set",
                    "Out",
                    "Nov",
                    "Dez"
                ];

                label.textContent =
                    names[
                        monthNumber-1
                    ];

            }else{

                label.textContent =
                    key;

            }

            column.appendChild(
                valueLabel
            );

            column.appendChild(
                bar
            );

            column.appendChild(
                label
            );

            container.appendChild(
                column
            );

        }
    );

}

/* =========================================================
