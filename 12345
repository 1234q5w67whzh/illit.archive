    <!-- ===================================================
         STATUS JAVASCRIPT
         =================================================== -->

    <script>

      /* =================================================
         STATISTICS STATE
         ================================================= */

      let statsPeriod = "month";

      const statsMembers = [

        {
          name: "YUNAH",
          icon: "🐆",
          color: "#ff3b30"
        },

        {
          name: "MINJU",
          icon: "🐰",
          color: "#ffcc00"
        },

        {
          name: "MOKA",
          icon: "☕️",
          color: "#af8cff"
        },

        {
          name: "WONHEE",
          icon: "🐿️",
          color: "#ffb6d9"
        },

        {
          name: "IROHA",
          icon: "🐢",
          color: "#8ed8ff"
        }

      ];

      /* =================================================
         SET PERIOD
         ================================================= */

      function setStatsPeriod(
        period,
        button
      ) {

        statsPeriod = period;

        document
          .querySelectorAll(
            ".stats-period-button"
          )
          .forEach(item => {

            item.classList.remove(
              "active"
            );

          });

        button.classList.add("active");

        updateStatistics();

      }

      /* =================================================
         GET STATISTICS ACTIVITIES
         ================================================= */

      function getStatisticsActivities() {

        let activities =
          [...calendarActivities];

        const type =
          document.getElementById(
            "statsTypeFilter"
          ).value;

        if (type !== "all") {

          activities =
            activities.filter(
              activity =>
                activity.type === type
            );

        }

        const selectedYear =
          calendarDate.getFullYear();

        const selectedMonth =
          calendarDate.getMonth();

        if (
          statsPeriod === "month"
        ) {

          activities =
            activities.filter(
              activity => {

                const date =
                  new Date(
                    activity.date +
                    "T12:00:00"
                  );

                return (
                  date.getFullYear() ===
                    selectedYear &&
                  date.getMonth() ===
                    selectedMonth
                );

              }
            );

        }

        if (
          statsPeriod === "year"
        ) {

          activities =
            activities.filter(
              activity => {

                const date =
                  new Date(
                    activity.date +
                    "T12:00:00"
                  );

                return (
                  date.getFullYear() ===
                  selectedYear
                );

              }
            );

        }

        return activities;

      }

      /* =================================================
         MEMBER COUNTS
         ================================================= */

      function getMemberStatistics() {

        const activities =
          getStatisticsActivities();

        const counts = {};

        statsMembers.forEach(
          member => {

            counts[member.name] = 0;

          }
        );

        activities.forEach(
          activity => {

            if (
              counts[
                activity.member
              ] !== undefined
            ) {

              counts[
                activity.member
              ]++;

            }

          }
        );

        return {
          activities,
          counts
        };

      }

      /* =================================================
         UPDATE STATISTICS
         ================================================= */

      function updateStatistics() {

        const result =
          getMemberStatistics();

        const activities =
          result.activities;

        const counts =
          result.counts;

        /*
         * Atividades individuais dos membros.
         * Atividades "all" representam grupo.
         */

        let totalMemberActivities = 0;

        statsMembers.forEach(
          member => {

            totalMemberActivities +=
              counts[member.name];

          }
        );

        /*
         * GROUP
         */

        const groupCount =
          activities.filter(
            activity =>
              activity.member === "all"
          ).length;

        /*
         * TOTAL
         */

        const total =
          activities.length;

        document
          .getElementById(
            "statsTotal"
          )
          .textContent =
            total;

        document
          .getElementById(
            "statsGraphTotal"
          )
          .textContent =
            total +
            (
              total === 1
                ? " atividade"
                : " atividades"
            );

        document
          .getElementById(
            "statsDonutNumber"
          )
          .textContent =
            total;

        document
          .getElementById(
            "groupActivityCount"
          )
          .textContent =
            groupCount;

        document
          .getElementById(
            "soloActivityCount"
          )
          .textContent =
            totalMemberActivities;

        renderStatsPeriodLabel();

        renderStatsDonut(
          counts
        );

        renderStatsMembers(
          counts,
          totalMemberActivities
        );

        renderComparison(
          counts
        );

        renderStatsAlerts(
          counts
        );

      }

      /* =================================================
         PERIOD LABEL
         ================================================= */

      function renderStatsPeriodLabel() {

        const year =
          calendarDate.getFullYear();

        const month =
          calendarDate.getMonth();

        let label = "";

        if (
          statsPeriod === "month"
        ) {

          label =
            calendarMonthNames[
              month
            ] +
            " " +
            year;

        }

        if (
          statsPeriod === "year"
        ) {

          label =
            "Ano " +
            year;

        }

        if (
          statsPeriod === "all"
        ) {

          label =
            "Todo o arquivo";

        }

        document
          .getElementById(
            "statsPeriodLabel"
          )
          .textContent =
            label;

      }

      /* =================================================
         DONUT GRAPH
         ================================================= */

      function renderStatsDonut(
        counts
      ) {

        const total =
          Object.values(counts)
            .reduce(
              (sum, value) =>
                sum + value,
              0
            );

        if (total === 0) {

          document
            .getElementById(
              "statsDonut"
            )
            .style.background =
              "conic-gradient(#e2e2e7 0deg 360deg)";

          return;

        }

        let currentDegree = 0;

        const segments = [];

        statsMembers.forEach(
          member => {

            const value =
              counts[member.name];

            if (value <= 0) {
              return;
            }

            const degrees =
              (
                value /
                total
              ) * 360;

            segments.push(
              member.color +
              " " +
              currentDegree +
              "deg " +
              (
                currentDegree +
                degrees
              ) +
              "deg"
            );

            currentDegree += degrees;

          }
        );

        document
          .getElementById(
            "statsDonut"
          )
          .style.background =
            "conic-gradient(" +
            segments.join(", ") +
            ")";

      }

      /* =================================================
         MEMBER LIST
         ================================================= */

      function renderStatsMembers(
        counts,
        total
      ) {

        const container =
          document.getElementById(
            "statsMemberList"
          );

        container.innerHTML = "";

        const values =
          statsMembers.map(
            member =>
              counts[member.name]
          );

        const max =
          Math.max(
            ...values
          );

        const min =
          Math.min(
            ...values
          );

        statsMembers.forEach(
          member => {

            const count =
              counts[member.name];

            const percentage =
              total > 0
                ? (
                    count /
                    total
                  ) * 100
                : 0;

            const row =
              document.createElement(
                "div"
              );

            row.className =
              "stats-member-row";

            row.style
              .setProperty(
                "--member-color",
                member.color
              );

            if (
              max > 0 &&
              count === max
            ) {

              row.classList.add(
                "most"
              );

            }

            if (
              count === min
            ) {

              row.classList.add(
                "least"
              );

            }

            row.innerHTML = `

              <div
                class="stats-member-dot"
              ></div>

              <div
                class="stats-member-emoji"
              >
                ${member.icon}
              </div>

              <div
                class="stats-member-name"
              >
                ${member.name}
              </div>

              <div
                class="stats-member-percentage"
              >
                ${percentage.toFixed(1)}%
              </div>

              <div
                class="stats-member-count"
              >
                ${count}
              </div>

            `;

            container.appendChild(
              row
            );

          }
        );

      }

      /* =================================================
         COMPARISON BARS
         ================================================= */

      function renderComparison(
        counts
      ) {

        const container =
          document.getElementById(
            "comparisonBars"
          );

        container.innerHTML = "";

        const values =
          statsMembers.map(
            member =>
              counts[member.name]
          );

        const max =
          Math.max(
            ...values,
            0
          );

        const min =
          Math.min(
            ...values
          );

        statsMembers.forEach(
          member => {

            const count =
              counts[member.name];

            const percentage =
              max > 0
                ? (
                    count /
                    max
                  ) * 100
                : 0;

            const row =
              document.createElement(
                "div"
              );

            row.className =
              "comparison-row";

            row.style
              .setProperty(
                "--member-color",
                member.color
              );

            if (
              max > 0 &&
              count === max
            ) {

              row.classList.add(
                "most"
              );

            }

            if (
              count === min
            ) {

              row.classList.add(
                "least"
              );

            }

            row.innerHTML = `

              <div
                class="comparison-name"
              >

                <span>
                  ${member.icon}
                </span>

                <span>
                  ${member.name}
                </span>

              </div>

              <div
                class="comparison-track"
              >

                <div
                  class="comparison-fill"
                  style="
                    width:${percentage}%;
                  "
                ></div>

              </div>

              <div
                class="comparison-number"
              >
                ${count}
              </div>

            `;

            container.appendChild(
              row
            );

          }
        );

      }

      /* =================================================
         ALERTS
         ================================================= */

      function renderStatsAlerts(
        counts
      ) {

        const container =
          document.getElementById(
            "statsAlerts"
          );

        container.innerHTML = "";

        const values =
          statsMembers.map(
            member =>
              counts[member.name]
          );

        const max =
          Math.max(
            ...values
          );

        const min =
          Math.min(
            ...values
          );

        const most =
          statsMembers.find(
            member =>
              counts[member.name] === max
          );

        const least =
          statsMembers.find(
            member =>
              counts[member.name] === min
          );

        if (
          max === 0
        ) {

          container.innerHTML = `

            <div
              class="stats-alert"
              style="--alert-color:#999;"
            >

              <div
                class="stats-alert-icon"
              >
                ✨
              </div>

              <div>

                <small>
                  Status
                </small>

                <strong>
                  Ainda não há dados suficientes.
                </strong>

              </div>

            </div>

          `;

          return;

        }

        container.innerHTML = `

          <div
            class="stats-alert"
            style="
              --alert-color:${most.color};
            "
          >

            <div
              class="stats-alert-icon"
            >
              ${most.icon}
            </div>

            <div>

              <small>
                Mais atividades
              </small>

              <strong>
                ${most.name}
              </strong>

            </div>

          </div>

          <div
            class="stats-alert"
            style="
              --alert-color:${least.color};
            "
          >

            <div
              class="stats-alert-icon"
            >
              🚨
            </div>

            <div>

              <small>
                Menos atividades
              </small>

              <strong>
                ${least.name}
              </strong>

            </div>

          </div>

        `;

      }

      /* =================================================
         CALENDAR ↔ STATUS
         ================================================= */

      const originalChangeCalendarMonth =
        changeCalendarMonth;

      changeCalendarMonth =
        function(direction) {

          originalChangeCalendarMonth(
            direction
          );

          updateStatistics();

        };

      /* =================================================
         INITIAL STATUS
         ================================================= */

      document.addEventListener(
        "DOMContentLoaded",
        function() {

          updateStatistics();

        }
      );

    </script>

