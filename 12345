/* =========================================================
   OBTER ATIVIDADES
   ========================================================= */

function getAdvancedStatsActivities(){

    let activities = [];

    try{

        activities =
            loadArchiveActivities();

    }catch(error){

        activities = [];

    }

    if(
        !Array.isArray(activities)
    ){

        activities = [];

    }

    return activities;

}

/* =========================================================
   CONVERTER DATA
   ========================================================= */

function advancedStatsDate(activity){

    const raw =
        activity.date ||
        activity.startDate ||
        activity.start ||
        "";

    if(!raw){
        return null;
    }

    const date =
        new Date(raw);

    if(
        Number.isNaN(
            date.getTime()
        )
    ){

        return null;

    }

    return date;

}

/* =========================================================
   IDENTIFICAR MEMBRO
   ========================================================= */

function getAdvancedActivityMember(
    activity
){

    const value = String(
        activity.member ||
        activity.who ||
        activity.artist ||
        ""
    ).toLowerCase();

    const found =
        ADVANCED_STATS_MEMBERS.find(
            member =>
                value === member.id ||
                value.includes(
                    member.name.toLowerCase()
                )
        );

    return found || null;

}

/* =========================================================
   TIPO
   ========================================================= */

function getAdvancedActivityType(
    activity
){

    return String(
        activity.type ||
        activity.activityType ||
        "other"
    ).toLowerCase();

}

/* =========================================================
   FILTROS
   ========================================================= */

function getAdvancedStatsFilters(){

    const month =
        document.getElementById(
            "advancedStatsMonth"
        );

    const year =
        document.getElementById(
            "advancedStatsYear"
        );

    const type =
        document.getElementById(
            "advancedStatsType"
        );

    return {

        month:
            month
                ? month.value
                : "all",

        year:
            year
                ? year.value
                : "all",

        type:
            type
                ? type.value
                : "all"

    };

}

/* =========================================================
   FILTRAR
   ========================================================= */

function filterAdvancedStatsActivities(){

    const filters =
        getAdvancedStatsFilters();

    const activities =
        getAdvancedStatsActivities();

    return activities.filter(
        activity => {

            const date =
                advancedStatsDate(
                    activity
                );

            if(!date){
                return false;
            }

            const year =
                String(
                    date.getFullYear()
                );

            const month =
                String(
                    date.getMonth()+1
                ).padStart(
                    2,
                    "0"
                );

            if(
                filters.year !== "all" &&
                year !== filters.year
            ){
                return false;
            }

            if(
                filters.month !== "all" &&
                month !== filters.month
            ){
                return false;
            }

            if(
                filters.type !== "all" &&
                getAdvancedActivityType(
                    activity
                ) !== filters.type
            ){
                return false;
            }

            return true;

        }
    );

}

/* =========================================================
   CONTAGEM POR MEMBRO
   ========================================================= */

function calculateAdvancedMemberCounts(
    activities
){

    const counts = {};

    ADVANCED_STATS_MEMBERS.forEach(
        member => {

            counts[
                member.id
            ] = 0;

        }
    );

    activities.forEach(
        activity => {

            const member =
                getAdvancedActivityMember(
                    activity
                );

            if(member){

                counts[
                    member.id
                ]++;

            }

        }
    );

    return counts;

}

/* =========================================================
   CORES DOS MEMBROS
   ========================================================= */

function applyAdvancedMemberColor(
    element,
    member,
    opacity = 1
){

    if(!element || !member){
        return;
    }

    /*
       Usamos color-mix quando disponível.
       O fallback continua usando a cor original.
    */

    if(
        opacity >= 1
    ){

        element.style.background =
            member.color;

    }else{

        element.style.background =
            `color-mix(
                in srgb,
                ${member.color} ${Math.round(
                    opacity * 100
                )}%,
                transparent
            )`;

    }

}

/* =========================================================
   MONTAR PAINEL AVANÇADO
   ========================================================= */

function injectAdvancedStatsPanel(){

    const status =
        document.getElementById(
