  if (
    Array.isArray(adminActivities) &&
    adminActivities.length > 0
  ) {

    return adminActivities
      .map(normalizeArchiveActivity);

  }

  /*
    Fallback para os dados da Parte 3.
  */

  if (
    typeof calendarActivities !== "undefined" &&
    Array.isArray(calendarActivities)
  ) {

    return calendarActivities
      .map(normalizeArchiveActivity);

  }

  return [];

}

/* =========================================================
   FILTRAR POR MEMBRO
   ========================================================= */

function getActivitiesForMember(member) {

  const activities =
    getArchiveCalendarActivities();

  if (member === "all") {

    return activities;

  }

  return activities.filter(
    activity =>
      activity.member === member
  );

}

/* =========================================================
   FILTRAR POR DATA
   ========================================================= */

function getActivitiesForDate(date) {

  const activities =
    getArchiveCalendarActivities();

  return activities.filter(activity => {

    const start =
      activity.startDate;

    const end =
      activity.endDate ||
      start;

    if (!start) return false;

    return (
      date >= start &&
      date <= end
    );

  });

}

/* =========================================================
   FILTRAR POR ABA ATUAL
   ========================================================= */

function getVisibleCalendarActivities() {

  const selectedMember =
    typeof selectedCalendarMember !== "undefined"
      ? selectedCalendarMember
      : "all";

  return getActivitiesForMember(
    selectedMember
  );

}

