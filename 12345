/* =========================================================
   ALERTA MAIS/MENOS
   ========================================================= */

function renderAdvancedStatsAlert(
    counts
){

    const alert =
        document.getElementById(
            "advancedStatsAlert"
        );

    if(!alert){
        return;
    }

    const ranked =
        ADVANCED_STATS_MEMBERS
            .map(
                member => ({
                    member,
                    count:
                        counts[
                            member.id
                        ] || 0
                })
            )
            .sort(
                (a,b) =>
                    b.count -
                    a.count
            );

    if(!ranked.length){

        alert.textContent =
            "✨ Nenhuma atividade encontrada.";

        return;

    }

    const most =
        ranked[0];

    const least =
        ranked[
            ranked.length-1
        ];

    alert.innerHTML = `

        ${most.member.emoji}
        <strong>
            Mais atividades:
        </strong>
        ${most.member.name}
        (${most.count})

        &nbsp; · &nbsp;

        🚨
        <strong>
            Menos atividades:
        </strong>
        ${least.member.name}
        (${least.count})

    `;

}

/* =========================================================
   RANKING EXTRA
   ========================================================= */

function renderAdvancedRanking(
    counts
){

    /*
       Se a Parte 4 já possui um ranking,
       não criamos outro.

       Esta função apenas procura um container
       dedicado caso seja adicionado futuramente.
    */

    const container =
        document.getElementById(
            "advancedStatsRanking"
        );

    if(!container){
        return;
    }

    const ranked =
        ADVANCED_STATS_MEMBERS
            .map(
                member => ({
                    member,
                    count:
                        counts[
                            member.id
                        ] || 0
                })
            )
            .sort(
                (a,b) =>
                    b.count -
                    a.count
            );

    const max =
        ranked.length
            ? ranked[0].count
            : 0;

    container.innerHTML = "";

    ranked.forEach(
        (item,index) => {

            const row =
                document.createElement(
                    "div"
                );

            row.className =
                "archive-ranking-row";

            if(index === 0){

                row.classList.add(
                    "is-first"
                );

            }

            if(index === ranked.length-1){

                row.classList.add(
                    "is-last"
                );

            }

            row.innerHTML = `

                <div class="archive-ranking-position">
                    ${index+1}
                </div>

                <div class="archive-ranking-member">

                    <div
                        class="archive-ranking-avatar"
                        style="background:${item.member.color}22"
                    >
                        ${item.member.emoji}
                    </div>

                    <div class="archive-ranking-name">
                        ${item.member.name}
                    </div>

                </div>

                <div class="archive-ranking-count">
                    ${item.count}
                </div>

            `;

            container.appendChild(
                row
            );

        }
    );

}

/* =========================================================
   RENDER PRINCIPAL
   ========================================================= */

function renderAdvancedStatistics(){

    const activities =
        filterAdvancedStatsActivities();

    const counts =
        calculateAdvancedMemberCounts(
            activities
        );

    renderAdvancedTimeline(
        activities
    );

    renderAdvancedLegend();

    renderAdvancedStatsAlert(
        counts
    );

    renderAdvancedRanking(
        counts
    );

    /*
       Atualizamos as estatísticas antigas
       depois das novas filtragens.
    */

    if(
        typeof updateArchiveStats ===
        "function"
    ){

        try{
            updateArchiveStats();
        }catch(error){}

    }

}

/* =========================================================
   INICIALIZAÇÃO
   ========================================================= */

function initializeAdvancedStatistics(){

    injectAdvancedStatsFilters();

    injectAdvancedStatsPanel();

    populateAdvancedStatsYears();

    renderAdvancedStatistics();

}

/* =========================================================
   QUANDO O DOCUMENTO ESTIVER PRONTO
   ========================================================= */

document.addEventListener(
    "DOMContentLoaded",
    () => {

        setTimeout(
            initializeAdvancedStatistics,
            600
        );

    }
);

/* =========================================================
   ATUALIZAR QUANDO O ARQUIVO MUDAR
   ========================================================= */

window.addEventListener(
    "storage",
    event => {

        if(
            event.key ===
            ARCHIVE_ACTIVITY_KEY
        ){

            setTimeout(
                () => {

                    populateAdvancedStatsYears();

                    renderAdvancedStatistics();

                },
                100
            );

        }

    }
);

/* =========================================================
   EXPORTAR
   ========================================================= */

window.renderAdvancedStatistics =
    renderAdvancedStatistics;

window.filterAdvancedStatsActivities =
    filterAdvancedStatsActivities;

</script>

