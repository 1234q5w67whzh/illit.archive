   ========================================================= */

const originalLoadAdminData =
  typeof loadAdminData === "function"
    ? loadAdminData
    : null;

function loadArchiveData() {

  let saved =
    localStorage.getItem("illitArchiveActivities");

  /*
    Se o usuário já adicionou atividades pelo Admin,
    usamos essas atividades.
  */

  if (saved) {

    try {

      adminActivities =
        JSON.parse(saved)
          .map(normalizeArchiveActivity);

    } catch(error) {

      console.error(
        "Erro ao carregar atividades.",
        error
      );

      adminActivities = [];

    }

  }

  /*
    Se não houver dados salvos, usamos as atividades
    existentes da Parte 3 como base.
  */

  if (
    adminActivities.length === 0 &&
    typeof calendarActivities !== "undefined" &&
    Array.isArray(calendarActivities)
  ) {

    adminActivities =
      calendarActivities
        .map(normalizeArchiveActivity);

  }

  /*
    Perfis salvos
  */

  const savedProfiles =
    localStorage.getItem("illitArchiveProfiles");

  if (savedProfiles) {

    try {

      const parsed =
        JSON.parse(savedProfiles);

      memberProfiles = {
        ...memberProfiles,
        ...parsed
      };

    } catch(error) {

      console.error(
        "Erro ao carregar perfis.",
        error
      );

    }

  }

}

/* =========================================================
   CONVERTER ADMIN → CALENDÁRIO
   ========================================================= */

function convertAdminActivitiesToCalendar() {

  return adminActivities.map(activity => {

    return {

      id:
        activity.id,

      member:
        activity.member,

      type:
        activity.type,

      title:
        activity.title,

      description:
        activity.description,

      date:
        activity.startDate,

      startDate:
        activity.startDate,

      endDate:
        activity.endDate ||
        activity.startDate,

      startTime:
        activity.startTime,

      endTime:
        activity.endTime,

      location:
        activity.location,

      city:
        activity.city,

      country:
        activity.country,

      status:
        activity.status,

      image:
        activity.image,

      officialLink:
        activity.officialLink,

      streamLink:
        activity.streamLink,

      notes:
        activity.notes

    };

  });

}

/* =========================================================
   ATUALIZAR CALENDÁRIO
   ========================================================= */

function syncAdminWithCalendar() {

  const converted =
    convertAdminActivitiesToCalendar();

  /*
    Substitui o array usado pela Parte 3.
  */

  if (
    typeof calendarActivities !== "undefined"
  ) {

    calendarActivities.length = 0;

    converted.forEach(activity => {

      calendarActivities.push(activity);

    });

  }

  /*
    Se a função original existir,
    redesenha o calendário.
  */

  if (
    typeof renderCalendar === "function"
  ) {

    try {

      renderCalendar();

    } catch(error) {

      console.log(
        "Calendário será atualizado na próxima interação."
      );

    }

  }

  if (
    typeof renderUpcomingActivities === "function"
  ) {

    try {

      renderUpcomingActivities();

    } catch(error) {}

  }

}

/* =========================================================
   ESTATÍSTICAS
   ========================================================= */

function getStatisticsActivities() {

  return adminActivities
    .filter(activity => activity.startDate);

}

/* =========================================================
   CONTAGEM DOS MEMBROS
   ========================================================= */

function calculateMemberStatistics() {

  const result = {

    YUNAH: 0,
    MINJU: 0,
    MOKA: 0,
    WONHEE: 0,
    IROHA: 0

  };

  adminActivities.forEach(activity => {

    if (
      result.hasOwnProperty(activity.member)
    ) {

      result[activity.member]++;

    }

  });

  return result;

}

/* =========================================================
   PORCENTAGENS
   ========================================================= */

function calculateMemberPercentages() {

  const counts =
    calculateMemberStatistics();

  const total =
    Object.values(counts)
      .reduce(
        (sum, value) => sum + value,
        0
      );

  const percentages = {};

  Object.keys(counts).forEach(member => {

    percentages[member] =
      total === 0
        ? 0
        : (counts[member] / total) * 100;

  });

  return {

    counts,
    percentages,
    total

  };

}

/* =========================================================
   RANKING
   ========================================================= */

function getMemberRanking() {

  const stats =
    calculateMemberPercentages();

  return Object.keys(stats.counts)
    .map(member => {

      return {

        member,
        count:
          stats.counts[member],

        percentage:
          stats.percentages[member]

      };

    })
    .sort(
      (a,b) => b.count - a.count
    );

}

/* =========================================================
   CORAÇÃO DE CADA MEMBRO
   ========================================================= */

function getMemberHeart(member) {

  const hearts = {

    YUNAH: "❤️",

    MINJU: "💛",

    MOKA: "💜",

    WONHEE: "🩷",

    IROHA: "🩵"

  };

  return hearts[member] || "✨";

}

