   EMOJI DE CADA MEMBRO
   ========================================================= */

function getMemberEmoji(member) {

  const emojis = {

    YUNAH: "🐆",

    MINJU: "🐰",

    MOKA: "☕️",

    WONHEE: "🐿️",

    IROHA: "🐢"

  };

  return emojis[member] || "✨";

}

/* =========================================================
   ATUALIZAR ALERTAS DE ESTATÍSTICAS
   ========================================================= */

function updateStatisticsAlerts() {

  const ranking =
    getMemberRanking();

  if (!ranking.length) return;

  const most =
    ranking[0];

  const least =
    ranking[ranking.length - 1];

  const mostName =
    document.getElementById("mostActivityName");

  const leastName =
    document.getElementById("leastActivityName");

  const mostIcon =
    document.getElementById("mostActivityIcon");

  const leastIcon =
    document.getElementById("leastActivityIcon");

  if (mostName) {

    mostName.textContent =
      most.member;

  }

  if (leastName) {

    leastName.textContent =
      least.member;

  }

  if (mostIcon) {

    mostIcon.textContent =
      getMemberHeart(most.member);

  }

  if (leastIcon) {

    leastIcon.textContent =
      "🚨";

  }

}

/* =========================================================
   ATUALIZAR CORES DO STATUS
   ========================================================= */

function updateStatisticsMemberRows() {

  const ranking =
    getMemberRanking();

  if (!ranking.length) return;

  const most =
    ranking[0].member;

  const least =
    ranking[ranking.length - 1].member;

  document
    .querySelectorAll("[data-stat-member]")
    .forEach(row => {

      const member =
        row.dataset.statMember;

      row.classList.remove(
        "stat-most",
        "stat-least"
      );

      if (member === most) {

        row.classList.add(
          "stat-most"
        );

      }

      if (
        member === least &&
        least !== most
      ) {

        row.classList.add(
          "stat-least"
        );

      }

    });

}

/* =========================================================
   GLITTER PARA O PRIMEIRO LUGAR
   ========================================================= */

function createStatSparkles() {

  const ranking =
    getMemberRanking();

  if (!ranking.length) return;

  const most =
    ranking[0].member;

  document
    .querySelectorAll(".stat-sparkles")
    .forEach(element => {

      element.innerHTML = "";

    });

  const target =
    document.querySelector(
      `[data-stat-member="${most}"]`
    );

  if (!target) return;

  let sparkleContainer =
    target.querySelector(".stat-sparkles");

  if (!sparkleContainer) {

    sparkleContainer =
      document.createElement("div");

    sparkleContainer.className =
      "stat-sparkles";

    target.appendChild(
      sparkleContainer
    );

  }

  for (
    let i = 0;
    i < 7;
    i++
  ) {

    const sparkle =
      document.createElement("span");

    sparkle.textContent =
      "✦";

    sparkle.style.left =
      Math.random() * 90 + "%";

    sparkle.style.top =
      Math.random() * 100 + "%";

    sparkle.style.animationDelay =
      (Math.random() * 1.5) + "s";

    sparkleContainer.appendChild(
      sparkle
