<script>
/* =========================================================
   PARTE 15 — FINAL
   ========================================================= */

/* =========================================================
   LOADING SCREEN
   ========================================================= */

function createArchiveLoading(){

    if(
        document.getElementById(
            "archiveLoading"
        )
    ){
        return;
    }

    const loading =
        document.createElement(
            "div"
        );

    loading.id =
        "archiveLoading";

    loading.className =
        "archive-loading";

    loading.innerHTML = `

        <div
            class="archive-loading-content"
        >

            <div
                class="archive-loading-icon"
            >
                ✨
            </div>

            <div
                class="archive-loading-text"
            >
                ILLIT Archive
            </div>

        </div>

    `;

    document.body.appendChild(
        loading
    );

    /*
       Pequeno atraso para evitar
       uma tela branca durante a montagem.
    */

    setTimeout(
        () => {

            loading.classList.add(
                "hidden"
            );

        },
        450
    );

}

/* =========================================================
   RODAPÉ
   ========================================================= */

function createArchiveFooter(){

    if(
        document.getElementById(
            "archiveFooter"
        )
    ){
        return;
    }

    const footer =
        document.createElement(
            "footer"
        );

    footer.id =
        "archiveFooter";

    footer.className =
        "archive-footer";

    footer.innerHTML = `

        <div
            class="archive-footer-logo"
        >
            ✨ ILLIT Archive
        </div>

        <div
            class="archive-footer-sub"
        >
            your little archive of ILLIT
        </div>

        <div
            class="archive-footer-sparkles"
        >
            ✨ ✨ ✨
        </div>

        <div
            class="archive-local-notice"
        >
            As alterações feitas pelo painel Admin
            são salvas neste navegador usando
            armazenamento local. Para que os dados
            sejam compartilhados entre dispositivos
            ou por outras pessoas, será necessário
            conectar um backend/banco de dados no futuro.
        </div>

    `;

    document.body.appendChild(
        footer
    );

}

/* =========================================================
   GARANTIR DADOS BÁSICOS
   ========================================================= */

function finalArchiveDataCheck(){

    try{

        const activities =
            loadArchiveActivities();

        if(
            !Array.isArray(
                activities
            )
        ){

            persistArchiveActivities(
                []
            );

        }

    }catch(error){

        console.warn(
            "Falha na verificação dos dados.",
            error
        );

    }

}

/* =========================================================
   SINCRONIZAÇÃO FINAL
   ========================================================= */

function finalArchiveSync(){

    if(
        typeof synchronizeEntireArchive ===
        "function"
    ){

        try{

            synchronizeEntireArchive(
                false
            );

        }catch(error){

            console.warn(
                "Falha na sincronização final.",
                error
            );

        }

    }

}

/* =========================================================
   GARANTIR TEMA
   ========================================================= */

function finalArchiveTheme(){

    try{

        if(
            typeof getSavedArchiveTheme ===
            "function"
        ){

            const theme =
                getSavedArchiveTheme();

            if(
                theme === "dark"
            ){

                document.documentElement
                    .classList
                    .add(
                        "dark-mode"
                    );

            }else if(
                theme === "light"
            ){

                document.documentElement
                    .classList
                    .remove(
                        "dark-mode"
                    );

            }

        }

    }catch(error){}

}

/* =========================================================
   VERIFICAÇÃO DOS LINKS INTERNOS
   ========================================================= */

function checkArchiveInternalLinks(){

    const links =
        document.querySelectorAll(
            'a[href^="#"]'
        );

    links.forEach(
        link => {

            const href =
                link.getAttribute(
                    "href"
                );

            if(!href || href === "#"){
                return;
            }

            const targetId =
                href.substring(1);

            if(
                !document.getElementById(
                    targetId
                )
            ){

                console.warn(
                    "Link interno sem destino:",
                    href
                );

            }

        }
    );

}

/* =========================================================
   ACESSIBILIDADE BÁSICA
   ========================================================= */

function improveArchiveAccessibility(){

    /*
       Imagens sem alt recebem um texto
       genérico para não ficarem totalmente
       sem descrição.
    */

    document.querySelectorAll(
        "img"
    ).forEach(
        img => {

            if(
                !img.hasAttribute(
                    "alt"
                )
            ){

                img.setAttribute(
                    "alt",
                    "Imagem do ILLIT Archive"
                );

            }

        }
    );

    /*
       Botões sem aria-label e sem texto
       recebem uma identificação.
    */

    document.querySelectorAll(
        "button"
    ).forEach(
        button => {

            const hasText =
                button.textContent
                    .trim()
                    .length > 0;

            if(
                !hasText &&
                !button.hasAttribute(
                    "aria-label"
                )
            ){

                button.setAttribute(
                    "aria-label",
                    "Botão"
                );

            }

        }
    );

}

/* =========================================================
   EVITAR DUPLO CARREGAMENTO
   ========================================================= */

let archiveFinalized =
    false;

/* =========================================================
   FINALIZAÇÃO PRINCIPAL
   ========================================================= */

function finalizeIllitArchive(){

    if(
        archiveFinalized
    ){
        return;
    }

    archiveFinalized =
        true;

    /*
       Ordem importante:
       dados → tema → sincronização →
       interface → acessibilidade
    */

    finalArchiveDataCheck();

    finalArchiveTheme();

    finalArchiveSync();

    /*
       Estes elementos são criados
       somente no final.
    */

    createArchiveLoading();

    createArchiveFooter();

    /*
       A navegação mobile já foi criada
       na Parte 14, mas garantimos novamente.
    */

    if(
        typeof injectArchiveMobileNavigation ===
        "function"
    ){

        injectArchiveMobileNavigation();

    }

    if(
        typeof injectArchiveBackTop ===
        "function"
    ){

        injectArchiveBackTop();

    }

    if(
        typeof updateArchiveMobileActive ===
        "function"
    ){

        updateArchiveMobileActive();

    }

    if(
        typeof updateArchiveBackTop ===
        "function"
    ){

        updateArchiveBackTop();

    }

    checkArchiveInternalLinks();

    improveArchiveAccessibility();

    /*
       Última atualização.
    */

    if(
        typeof updateArchiveLastSyncText ===
        "function"
    ){

        updateArchiveLastSyncText();

    }

}

/* =========================================================
   INICIAR
   ========================================================= */

if(
    document.readyState ===
    "loading"
){

    document.addEventListener(
        "DOMContentLoaded",
        finalizeIllitArchive
    );

}else{

    finalizeIllitArchive();

}

/* =========================================================
   ÚLTIMA PROTEÇÃO
   ========================================================= */

window.addEventListener(
    "load",
    () => {

        setTimeout(
            () => {

                if(
                    typeof finalArchiveSync ===
                    "function"
                ){

                    finalArchiveSync();

                }

                if(
                    typeof improveArchiveAccessibility ===
                    "function"
                ){

                    improveArchiveAccessibility();

                }

            },
            800
        );

    }
);

/* =========================================================
   ILLIT ARCHIVE — FINAL
   ========================================================= */

console.log(
    "✨ ILLIT Archive carregado."
);

</script>

